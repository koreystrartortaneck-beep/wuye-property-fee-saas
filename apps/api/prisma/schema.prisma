// 物业费 SaaS 数据模型（spec §5）
// 所有金额 DECIMAL(12,2)；租户域表带 tenantId 并建索引

generator client {
  provider      = "prisma-client-js"
  // 本机 + 服务器容器（Debian bookworm / OpenSSL 3）
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- 枚举（取值与 @pf/shared 一致） ----------

enum HouseType {
  RESIDENCE
  PARKING
  SHOP
}

enum RuleType {
  AREA_PRICE
  FIXED
  METER
  SHARE
  FORMULA
}

enum RulePeriod {
  MONTHLY
  QUARTERLY
  YEARLY
}

/**
 * 账期方案。RulePeriod 的超集:前三个值与 RulePeriod 一一对应(迁移时按旧值回填),
 * ANNIVERSARY 是新增的「按户周年」—— 每户以自己的放户日期(House.handoverDate)
 * 为锚,账期是 2026-03-15 ~ 2027-03-14 这样的按户区间,而不是全小区统一的自然月/年。
 * 为什么不复用 RulePeriod 加值:两者语义开始分叉 ——
 * RulePeriod 回答「多久出一次」,PeriodScheme 回答「账期怎么锚定、房屋怎么选」。
 * legacy 三个值仍走按 houseType 自动匹配的旧路径;ANNIVERSARY 只经 HouseStandard 挂接选房。
 * (季节性费种如取暖费,目前明确不归我们收;将来需要时在此追加值即可,MySQL ENUM 追加在线安全。)
 */
enum PeriodScheme {
  MONTHLY
  QUARTERLY
  YEARLY
  ANNIVERSARY
}

/**
 * 金额取整。物业的手工账本按整元记(100.24㎡ × 1.4 × 12 = 1684 元,不是 1684.03),
 * 系统必须能对上,否则 555 户每户差几分,对账对不齐。
 * CENT 为既有行为(分级精度),YUAN 半进到整元。取整方式随标准配置、随账单快照留痕。
 */
enum AmountRounding {
  CENT
  YUAN
}

enum MeterType {
  WATER
  ELEC
  GAS
}

enum BillStatus {
  UNPAID
  PAID
  CANCELED
  DRAFT
  REFUNDING
  REFUNDED
}

enum BillRunStatus {
  RUNNING
  DONE
  FAILED
}

enum PaymentStatus {
  CREATED
  SUCCESS
  FAILED
  CLOSED
  REFUNDED
  PREPAY_UNKNOWN
}

enum PaymentChannel {
  MOCK
  WXPAY
  OFFLINE
}

enum BillBatchStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  FAILED
  CANCELED
}

enum BillSource {
  RULE
  IMPORT
}

enum PaymentConfirmationSource {
  WXPAY_NOTIFY
  WXPAY_QUERY
  OFFLINE
  MOCK
}

enum RefundType {
  FULL
}

enum RefundStatus {
  CREATED
  PROCESSING
  SUCCESS
  FAILED
  CLOSED
  ABNORMAL
}

enum RefundAttemptStatus {
  PENDING
  SUCCESS
  FAILED
  UNKNOWN
}

enum ReconciliationRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum ReconciliationBillType {
  TRANSACTION
  REFUND
}

enum ReconciliationDifferenceType {
  CHANNEL_MISSING
  LOCAL_MISSING
  AMOUNT_MISMATCH
  STATUS_MISMATCH
  REFUND_MISMATCH
}

enum ReconciliationItemStatus {
  OPEN
  AUTO_RESOLVED
  MANUALLY_CLOSED
  ESCALATED
}

enum AuditActorType {
  SYSTEM
  ADMIN
  WX_USER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  CANCEL
  PAY
  REFUND
  RECONCILE
  INVOICE
  RECOVER
}

enum PaymentEventType {
  CREATED
  CHANNEL_ORDER_CREATED
  NOTIFIED
  CONFIRMED
  CLOSED
  FAILED
  REFUNDING
  REFUNDED
  RECOVERED
}

enum PaymentEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum IdempotencyStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

enum InvoiceTitleType {
  PERSONAL
  ENTERPRISE
}

enum InvoiceApplicationStatus {
  SUBMITTED
  PROCESSING
  ISSUED
  REJECTED
  CANCELED
  REVERSAL_REQUIRED
  REVERSED
}

enum CollectionPolicyStatus {
  OPEN
  PAUSED
}

enum BindingStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum BindingRelation {
  OWNER
  FAMILY
  TENANT
}

enum BindingSource {
  PHONE_MATCH
  APPLY
}

enum AdminRole {
  SUPER_ADMIN
  PLATFORM_READONLY
  TENANT_ADMIN
  STAFF
}

enum NotifyType {
  BILL_CREATED
  DUE_SOON
  OVERDUE
}

enum NotifyStatus {
  SENT
  FAILED
  SKIPPED
}

enum EntityStatus {
  ACTIVE
  DISABLED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  DELIVERED
  FAILED
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// ---------- 租户与组织 ----------

model Tenant {
  id           String       @id @default(cuid())
  name         String
  code         String       @unique
  contactName  String?
  contactPhone String?
  subMchId     String? // 微信支付特约商户号（子项目5）
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  admins           AdminUser[]
  communities      Community[]
  auditLogs        AuditLog[]              @relation("AuditLogTenant")
  collectionPolicy TenantCollectionPolicy?
  bindingConfig    TenantBindingConfig?
}

/**
 * 绑定渠道开关(租户级)。形状抄 TenantCollectionPolicy 的先例:
 * 一租户一行,缺行 = 全默认(渠道全开、自助申请需审批)—— 懒解析,
 * 不需要为存量租户回填。将来要按小区细分时加一层 CommunityBindingConfig,
 * 解析器照 collection-policy 的 most-specific-wins 抄即可,不返工。
 * 三个开关的含义(服务端强制,小程序 UI 只是跟着显隐):
 * phoneMatch             关 → 授权手机号不再自动匹配房屋
 * selfApply              关 → POST /owner/bindings 直接拒绝,小程序隐藏申请入口
 * selfApplyNeedsApproval 关 → 申请即生效(直接 ACTIVE,写 BINDING_AUTO_APPROVE 审计)
 */
model TenantBindingConfig {
  id                     String   @id @default(cuid())
  tenantId               String   @unique
  phoneMatch             Boolean  @default(true)
  selfApply              Boolean  @default(true)
  selfApplyNeedsApproval Boolean  @default(true)
  changedBy              String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  tenant  Tenant     @relation(fields: [tenantId], references: [id])
  changer AdminUser? @relation("BindingConfigChanger", fields: [tenantId, changedBy], references: [tenantId, id], onUpdate: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, changedBy])
}

model AdminUser {
  id           String       @id @default(cuid())
  tenantId     String? // null = 平台超管
  username     String       @unique
  passwordHash String
  name         String
  /**
   * 小程序免密登录的凭据:微信授权手机号(运营商核验过的本人号码)
   * 匹配此列即换发管理员令牌(见 auth.controller 的 admin-exchange)。
   * 全局唯一 —— 一号一账号,否则换发时无法确定给哪个租户的权限。
   */
  phone        String?      @unique
  role         AdminRole
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  // 会话加固（Task 3）
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  tokenVersion       Int       @default(0)
  passwordChangedAt  DateTime?
  mustChangePassword Boolean   @default(false)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  publishedBills             Bill[]                      @relation("BillPublisher")
  canceledBills              Bill[]                      @relation("BillCanceler")
  createdBillBatches         BillBatch[]                 @relation("BillBatchCreator")
  publishedBillBatches       BillBatch[]                 @relation("BillBatchPublisher")
  canceledBillBatches        BillBatch[]                 @relation("BillBatchCanceler")
  offlinePayments            Payment[]                   @relation("PaymentOfflineOperator")
  requestedRefunds           Refund[]                    @relation("RefundRequester")
  createdReconciliationRuns  ReconciliationRun[]         @relation("ReconciliationRunCreator")
  handledReconciliationItems ReconciliationItem[]        @relation("ReconciliationItemHandler")
  processedInvoices          InvoiceApplication[]        @relation("InvoiceProcessor")
  changedPlatformPolicies    PlatformCollectionPolicy[]  @relation("PlatformPolicyChanger")
  changedTenantPolicies      TenantCollectionPolicy[]    @relation("TenantPolicyChanger")
  changedBindingConfigs      TenantBindingConfig[]       @relation("BindingConfigChanger")
  changedCommunityPolicies   CommunityCollectionPolicy[] @relation("CommunityPolicyChanger")

  @@unique([tenantId, id])
  @@index([tenantId])
}

model Community {
  id           String       @id @default(cuid())
  tenantId     String
  name         String
  address      String?
  servicePhone String? // 管家/客服电话
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  tenant              Tenant                     @relation(fields: [tenantId], references: [id])
  houses              House[]                    @relation("HouseCommunityTenant")
  legacyHouses        House[]                    @relation("HouseCommunityLegacy")
  feeRules            FeeRule[]                  @relation("FeeRuleCommunity")
  bills               Bill[]                     @relation("BillCommunity")
  billBatches         BillBatch[]                @relation("BillBatchCommunity")
  payments            Payment[]                  @relation("PaymentCommunity")
  refunds             Refund[]                   @relation("RefundCommunity")
  refundAttempts      RefundAttempt[]            @relation("RefundAttemptCommunity")
  reconciliationRuns  ReconciliationRun[]        @relation("ReconciliationRunCommunity")
  reconciliationItems ReconciliationItem[]       @relation("ReconciliationItemCommunity")
  auditLogs           AuditLog[]                 @relation("AuditLogCommunity")
  paymentEvents       PaymentEvent[]             @relation("PaymentEventCommunity")
  idempotencyRecords  IdempotencyRecord[]        @relation("IdempotencyCommunity")
  outboxEvents        OutboxEvent[]              @relation("OutboxCommunity")
  invoiceApplications InvoiceApplication[]       @relation("InvoiceCommunity")
  collectionPolicy    CommunityCollectionPolicy?

  /// 同一物业公司内小区名不得重复。
  /// 起因：House 有 @@unique([communityId, code]) 防重复房号，而小区名没有任何约束。
  /// 审计时手滑建了第二个「金港城」并成功——业主端搜索会看到两个一模一样的小区，
  /// 选错就绑到空小区去，物业还得人工发现。房号都防重了，小区名更该防。
  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model House {
  id           String       @id @default(cuid())
  tenantId     String
  communityId  String
  type         HouseType    @default(RESIDENCE)
  building     String?
  unit         String?
  room         String?
  code         String // "8-1-2602" / "B2-118"
  displayName  String // "8 栋 1 单元 2602"
  area         Decimal?     @db.Decimal(10, 2)
  /**
   * ownerName/ownerPhone 已被 HouseContact 取代(一套房多个授权手机号),
   * 列冻结:回填进 HouseContact 后从写 DTO 与匹配查询移除,
   * 物理删列等真实数据导入验证后另行迁移 —— 加列删列分开,回滚才有路。
   */
  ownerName    String?
  ownerPhone   String?
  /**
   * 放户日期 —— 按户周年账期(PeriodScheme.ANNIVERSARY)的锚点。
   * 物业的收费规律:每家每户的物业费从各自交房那天起算年度,
   * 3/15 放户 → 账期 2026-03-15 ~ 2027-03-14,全小区没有统一的出账日。
   * 可空:缺失时该房在周年出账里报 HANDOVER_DATE_MISSING 跳过,绝不静默丢。
   */
  handoverDate DateTime?    @db.Date
  status       EntityStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())

  community       Community       @relation("HouseCommunityTenant", fields: [tenantId, communityId], references: [tenantId, id])
  legacyCommunity Community       @relation("HouseCommunityLegacy", fields: [communityId], references: [id], onDelete: Restrict)
  bindings        HouseBinding[]
  contacts        HouseContact[]
  houseStandards  HouseStandard[]
  bills           Bill[]          @relation("BillHouseTenant")
  legacyBills     Bill[]          @relation("BillHouseLegacy")
  tickets         Ticket[]
  visitorPasses   VisitorPass[]
  serviceOrders   ServiceOrder[]

  @@unique([communityId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([ownerPhone])
}

/**
 * 房屋的授权手机号列表 —— 绑定房屋的主数据源。
 * 取代 House.ownerPhone 单字段:一套房可以同时给业主、家属、租客看
 * (产品决策:不区分角色权限,所有授权的人看到的完全一样,name 只是物业的备注)。
 * 物业加号 = 授权:该手机号的微信用户授权手机号后立即绑上(已授权过的当场绑上)。
 * 物业删号 = 解绑:该号对应的绑定在同一事务里立即失效 —— 换租就是「删旧号+加新号」。
 * 自助申请审批通过时,申请人手机号自动写入此表(单一数据源,两套机制不各存一份)。
 */
model HouseContact {
  id        String   @id @default(cuid())
  tenantId  String
  houseId   String
  phone     String // 入库前经 normalizePhone 归一
  name      String? // 备注姓名,仅物业自己看
  createdBy String? // AdminUser.id;回填/审批自动写入时为 null
  // 来源:ADMIN 手工 / BACKFILL 迁移回填 / APPLY_APPROVED 审批联动 / IMPORT 批量导入。
  // 用 String 不用 enum:纯溯源字段,无业务分支,加值不迁移。
  source    String   @default("ADMIN")
  createdAt DateTime @default(now())

  house House @relation(fields: [tenantId, houseId], references: [tenantId, id])

  @@unique([houseId, phone])
  @@unique([tenantId, id])
  @@index([tenantId])
  // 手机号匹配的主路径(接替 House.@@index([ownerPhone])):授权时按 phone 找房
  @@index([phone])
}

// ---------- 业主与绑定 ----------

model WxUser {
  id           String    @id @default(cuid())
  openid       String    @unique
  unionid      String?
  phone        String?
  nickname     String?
  tokenVersion Int       @default(0)
  phoneBoundAt DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  bindings            HouseBinding[]
  payments            Payment[]
  invoiceApplications InvoiceApplication[]
  tickets             Ticket[]

  @@index([phone])
}

model HouseBinding {
  id             String          @id @default(cuid())
  tenantId       String
  wxUserId       String
  houseId        String
  relation       BindingRelation @default(OWNER)
  status         BindingStatus   @default(PENDING)
  source         BindingSource
  applicantName  String?
  reviewedBy     String?
  reviewedAt     DateTime?
  rejectReason   String?
  phoneMatchedAt DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  createdAt      DateTime        @default(now())

  wxUser WxUser @relation(fields: [wxUserId], references: [id])
  house  House  @relation(fields: [houseId], references: [id])

  @@unique([wxUserId, houseId])
  @@index([tenantId])
  @@index([houseId])
  // 实名审核列表：按状态筛 + createdAt desc 排序
  @@index([tenantId, status, createdAt])
}

// ---------- 计费与账单 ----------

model FeeRule {
  id           String         @id @default(cuid())
  tenantId     String
  communityId  String
  name         String
  category     String?
  /**
   * 标准代号,如 "WYF-ZZ"(住宅物业费)。跨小区的「同一条标准」靠它对齐:
   * 开新楼盘时「复制收费标准」按 code 克隆目录、已存在的跳过。
   * 可空 —— legacy 规则没有 code(MySQL 唯一索引允许多个 NULL,旧行不受影响)。
   */
  code         String?
  houseType    HouseType      @default(RESIDENCE)
  ruleType     RuleType
  params       Json
  period       RulePeriod     @default(MONTHLY)
  /**
   * 账期方案(见枚举注释)。回填 = 旧 period 值,行为不变;
   * ANNIVERSARY 时本行的 houseType 不再参与选房(选房走 HouseStandard 挂接),
   * billDay 复用为「每月自动生成草稿的触发日」,dueDays 仍是缴费期限天数。
   */
  periodScheme PeriodScheme   @default(MONTHLY)
  /**
   * 金额取整(见枚举注释)。周年年费用 YUAN 对齐物业手工账本。
   */
  rounding     AmountRounding @default(CENT)
  billDay      Int            @default(1) // 1-28
  dueDays      Int            @default(15)
  enabled      Boolean        @default(true)
  createdAt    DateTime       @default(now())

  community      Community       @relation("FeeRuleCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  bills          Bill[]          @relation("BillRuleTenant")
  legacyBills    Bill[]          @relation("BillRuleLegacy")
  billRuns       BillRun[]       @relation("BillRunRuleTenant")
  legacyBillRuns BillRun[]       @relation("BillRunRuleLegacy")
  billBatches    BillBatch[]
  houseStandards HouseStandard[]

  @@unique([tenantId, id])
  @@unique([communityId, code])
  @@index([tenantId])
  @@index([communityId])
}

/**
 * 房屋 ↔ 收费标准的挂接 —— ANNIVERSARY 方案的选房依据。
 * legacy 规则按「小区 + houseType」自动全选房屋,真实数据里每条例外
 * (2 期 4 号楼 1.2 元、商场包租固定额、免收)都落在这个粒度之外。
 * 挂接把选择权交给物业:挂了才出账,不挂 = 不出账(免收/空置就是不挂)。
 * 调价改标准那一条,挂着的房屋下次出账全部跟着变。
 * startDate 覆盖 House.handoverDate 作为首个账期锚点(如年中新挂接);
 * endDate 是「摘除」:到期后不再生成,历史账单保留 —— 不做硬删,
 * 否则「这房去年按哪条标准收的」就无从回答。
 */
model HouseStandard {
  id        String       @id @default(cuid())
  tenantId  String
  houseId   String
  ruleId    String
  startDate DateTime?    @db.Date
  endDate   DateTime?    @db.Date
  status    EntityStatus @default(ACTIVE)
  createdBy String?
  createdAt DateTime     @default(now())

  house House   @relation(fields: [tenantId, houseId], references: [tenantId, id])
  rule  FeeRule @relation(fields: [tenantId, ruleId], references: [tenantId, id])

  @@unique([houseId, ruleId])
  @@unique([tenantId, id])
  @@index([tenantId])
  // 月度扫描的主路径:一条标准下全部生效挂接
  @@index([ruleId, status])
  @@index([tenantId, houseId])
}

model MeterReading {
  id        String    @id @default(cuid())
  tenantId  String
  houseId   String
  meterType MeterType
  period    String // "2026-07"
  value     Decimal   @db.Decimal(12, 2)
  prevValue Decimal?  @db.Decimal(12, 2)
  createdBy String?
  createdAt DateTime  @default(now())

  @@unique([houseId, meterType, period])
  @@index([tenantId])
}

model SharePool {
  id          String   @id @default(cuid())
  tenantId    String
  ruleId      String
  period      String
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@unique([ruleId, period])
  @@index([tenantId])
}

model BillRun {
  id            String        @id @default(cuid())
  tenantId      String
  ruleId        String
  period        String
  status        BillRunStatus @default(RUNNING)
  total         Int           @default(0)
  generated     Int           @default(0)
  skipped       Int           @default(0)
  skippedDetail Json?
  startedAt     DateTime      @default(now())
  finishedAt    DateTime?

  rule        FeeRule @relation("BillRunRuleTenant", fields: [tenantId, ruleId], references: [tenantId, id])
  legacyRule  FeeRule @relation("BillRunRuleLegacy", fields: [ruleId], references: [id])
  bills       Bill[]  @relation("BillBillRunTenant")
  legacyBills Bill[]  @relation("BillBillRunLegacy")

  @@unique([ruleId, period])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model Bill {
  id             String      @id @default(cuid())
  tenantId       String
  communityId    String
  houseId        String
  ruleId         String?
  billRunId      String?
  batchId        String?
  source         BillSource?
  sourceRowKey   String?
  period         String
  title          String
  snapshot       Json
  amount         Decimal     @db.Decimal(12, 2)
  status         BillStatus  @default(UNPAID)
  dueDate        DateTime
  publishedAt    DateTime?
  publishedBy    String?
  paidAt         DateTime?
  /// 占用/成交该账单的支付。唯一约束是资金侧的兜底：当前模型是「单账单单支付」
  /// （createPayment 明确拒绝数组入参），两处写入都是按 id 单条更新 + count 校验。
  /// 加上唯一索引后，万一将来有代码把两张账单指向同一笔支付，会在写入时立刻失败，
  /// 而不是静默产生一笔钱销两张账单的脏数据。可空列的唯一索引在 MySQL 允许多个 NULL。
  paymentId      String?     @unique
  canceledAt     DateTime?
  canceledBy     String?
  cancelReason   String?
  replacesBillId String?
  createdAt      DateTime    @default(now())

  community        Community     @relation("BillCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  house            House         @relation("BillHouseTenant", fields: [tenantId, houseId], references: [tenantId, id])
  legacyHouse      House         @relation("BillHouseLegacy", fields: [houseId], references: [id])
  rule             FeeRule?      @relation("BillRuleTenant", fields: [tenantId, ruleId], references: [tenantId, id])
  legacyRule       FeeRule?      @relation("BillRuleLegacy", fields: [ruleId], references: [id], onDelete: Restrict)
  billRun          BillRun?      @relation("BillBillRunTenant", fields: [tenantId, billRunId], references: [tenantId, id])
  legacyBillRun    BillRun?      @relation("BillBillRunLegacy", fields: [billRunId], references: [id], onDelete: Restrict)
  batch            BillBatch?    @relation(fields: [tenantId, batchId], references: [tenantId, id])
  publisher        AdminUser?    @relation("BillPublisher", fields: [tenantId, publishedBy], references: [tenantId, id])
  canceler         AdminUser?    @relation("BillCanceler", fields: [tenantId, canceledBy], references: [tenantId, id])
  replacesBill     Bill?         @relation("BillReplacement", fields: [tenantId, replacesBillId], references: [tenantId, id])
  replacementBills Bill[]        @relation("BillReplacement")
  primaryPayments  Payment[]     @relation("PaymentPrimaryBill")
  refunds          Refund[]
  paymentBills     PaymentBill[]

  @@unique([ruleId, houseId, period])
  @@unique([tenantId, id])
  @@unique([tenantId, batchId, sourceRowKey])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([tenantId, publishedBy])
  @@index([tenantId, canceledBy])
  @@index([tenantId, replacesBillId])
  @@index([batchId])
  @@index([houseId, status])
  @@index([status, dueDate])
  // 欠费清单 / 催缴 / 收缴统计的实际查询组合。原先 status 落不到索引，
  // 3000 户小区单月 12000+ 张未缴账单要靠 @@index([tenantId]) 之后逐行过滤。
  @@index([tenantId, status, communityId])
  // stats/summary、stats/by-community、today 都按账期查，而 period 此前完全无索引
  @@index([tenantId, period, status])
  // 账单列表默认 ORDER BY createdAt desc，无此索引每次翻页都要对全量行做 filesort
  @@index([tenantId, createdAt])
}

// ---------- 支付与通知 ----------

model Payment {
  id                   String                     @id @default(cuid())
  tenantId             String
  wxUserId             String?
  billId               String?
  communityId          String?
  orderNo              String                     @unique
  merchantAccountId    String?
  mchid                String?
  appid                String?
  totalAmount          Decimal                    @db.Decimal(12, 2)
  channel              PaymentChannel             @default(MOCK)
  status               PaymentStatus              @default(CREATED)
  transactionId        String?                    @unique
  confirmedBy          PaymentConfirmationSource?
  confirmedAt          DateTime?
  wxpayNotifiedAt      DateTime?
  expiresAt            DateTime?
  closedAt             DateTime?
  lastSyncedAt         DateTime?
  failureCode          String?
  failureMessage       String?
  receiptNo            String?                    @unique
  receiptSnapshot      Json?
  /// 优惠券抵扣：券面额记入 discountAmount，totalAmount 为业主实付。
  /// 二者之和应等于账单原额，差额为物业承担的营销成本。
  discountAmount       Decimal?                   @db.Decimal(12, 2)
  userCouponId         String?                    @unique
  offlineVoucherNo     String?                    @unique
  offlinePaidAt        DateTime?
  offlineOperatorId    String?
  offlinePayerSnapshot Json?
  offlineRemark        String?
  recoveredAt          DateTime?
  recoveredBy          String?
  recoveryReason       String?
  paidAt               DateTime?
  createdAt            DateTime                   @default(now())

  wxUser              WxUser?              @relation(fields: [wxUserId], references: [id], onDelete: Restrict)
  bill                Bill?                @relation("PaymentPrimaryBill", fields: [tenantId, billId], references: [tenantId, id])
  community           Community?           @relation("PaymentCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  offlineOperator     AdminUser?           @relation("PaymentOfflineOperator", fields: [tenantId, offlineOperatorId], references: [tenantId, id], onUpdate: Restrict)
  refund              Refund?
  reconciliationItems ReconciliationItem[]
  events              PaymentEvent[]
  invoiceApplication  InvoiceApplication?
  paymentBills        PaymentBill[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([wxUserId])
  @@index([billId])
  @@index([communityId, status])
  @@index([channel, status, createdAt])
  @@index([tenantId, offlineOperatorId])
  // 对账按「租户 + 渠道 + 状态 + 到账时刻」取当日流水。
  // 现有 ([channel, status, createdAt]) 前缀不含 tenantId，paidAt 更是完全无索引，
  // 于是每天 10:30 的对账在租户内做全表扫（第三年约 9.7 万行）。
  @@index([tenantId, channel, status, paidAt])
}

model PaymentBill {
  paymentId String
  billId    String

  payment Payment @relation(fields: [paymentId], references: [id])
  bill    Bill    @relation(fields: [billId], references: [id])

  @@id([paymentId, billId])
  @@index([billId])
}

model BillBatch {
  id             String          @id @default(cuid())
  tenantId       String
  communityId    String
  batchNo        String
  period         String
  title          String?
  source         BillSource
  ruleId         String?
  importFileName String?
  importFileHash String?
  status         BillBatchStatus @default(DRAFT)
  totalRows      Int             @default(0)
  validRows      Int             @default(0)
  invalidRows    Int             @default(0)
  totalAmount    Decimal         @default(0) @db.Decimal(12, 2)
  createdBy      String?
  publishedAt    DateTime?
  publishedBy    String?
  canceledAt     DateTime?
  canceledBy     String?
  cancelReason   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  community Community  @relation("BillBatchCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  rule      FeeRule?   @relation(fields: [tenantId, ruleId], references: [tenantId, id], onUpdate: Restrict)
  creator   AdminUser? @relation("BillBatchCreator", fields: [tenantId, createdBy], references: [tenantId, id])
  publisher AdminUser? @relation("BillBatchPublisher", fields: [tenantId, publishedBy], references: [tenantId, id])
  canceler  AdminUser? @relation("BillBatchCanceler", fields: [tenantId, canceledBy], references: [tenantId, id])
  bills     Bill[]

  @@unique([tenantId, batchNo])
  @@unique([tenantId, id])
  @@unique([tenantId, communityId, importFileHash])
  @@index([tenantId])
  @@index([communityId, status])
  @@index([tenantId, ruleId])
  @@index([tenantId, createdBy])
  @@index([tenantId, publishedBy])
  @@index([tenantId, canceledBy])
  @@index([period])
}

model Refund {
  id                String         @id @default(cuid())
  tenantId          String
  communityId       String?
  paymentId         String         @unique
  paymentOrderNo    String
  billId            String?
  merchantAccountId String
  mchid             String
  appid             String
  refundNo          String         @unique
  providerRefundId  String?        @unique
  type              RefundType
  originalAmount    Decimal        @db.Decimal(12, 2)
  refundAmount      Decimal        @db.Decimal(12, 2)
  currency          String         @default("CNY") @db.Char(3)
  reason            String
  channel           PaymentChannel
  status            RefundStatus   @default(CREATED)
  requestedBy       String?
  requestedAt       DateTime       @default(now())
  processingAt      DateTime?
  refundedAt        DateTime?
  notifyReceivedAt  DateTime?
  lastQueriedAt     DateTime?
  failedAt          DateTime?
  closedAt          DateTime?
  failureCode       String?
  failureMessage    String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @default(now()) @updatedAt

  payment             Payment              @relation(fields: [tenantId, paymentId], references: [tenantId, id])
  bill                Bill?                @relation(fields: [tenantId, billId], references: [tenantId, id])
  community           Community?           @relation("RefundCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  requester           AdminUser?           @relation("RefundRequester", fields: [tenantId, requestedBy], references: [tenantId, id])
  attempts            RefundAttempt[]
  reconciliationItems ReconciliationItem[]
  events              PaymentEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, paymentId])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([tenantId, requestedBy])
  @@index([paymentOrderNo])
  @@index([billId])
  // 对账的退款侧：channel/status/refundedAt 此前全无索引
  @@index([tenantId, channel, status, refundedAt])
  // 退款恢复任务每 10 分钟按 channel+status 扫一次并按 requestedAt 排序
  @@index([channel, status, requestedAt])
}

model RefundAttempt {
  id              String              @id @default(cuid())
  tenantId        String
  communityId     String?
  refundId        String
  attemptNo       Int
  status          RefundAttemptStatus @default(PENDING)
  requestHash     String
  requestSummary  Json?
  responseSummary Json?
  errorCode       String?
  errorMessage    String?
  attemptedAt     DateTime            @default(now())
  finishedAt      DateTime?

  refund    Refund     @relation(fields: [tenantId, refundId], references: [tenantId, id])
  community Community? @relation("RefundAttemptCommunity", fields: [tenantId, communityId], references: [tenantId, id])

  @@unique([tenantId, refundId, attemptNo])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([status, attemptedAt])
}

model ReconciliationRun {
  id                    String                  @id @default(cuid())
  tenantId              String
  communityId           String?
  runNo                 String                  @unique
  merchantAccountId     String
  mchid                 String
  appid                 String
  channel               PaymentChannel
  businessDate          DateTime                @db.Date
  billType              ReconciliationBillType
  channelFileHash       String?
  channelRecordCount    Int                     @default(0)
  channelAmount         Decimal                 @default(0) @db.Decimal(12, 2)
  localRecordCount      Int                     @default(0)
  localAmount           Decimal                 @default(0) @db.Decimal(12, 2)
  matchedRecordCount    Int                     @default(0)
  differenceRecordCount Int                     @default(0)
  differenceAmount      Decimal                 @default(0) @db.Decimal(12, 2)
  status                ReconciliationRunStatus @default(RUNNING)
  leaseOwner            String?
  leaseExpiresAt        DateTime?
  errorMessage          String?
  createdBy             String?
  startedAt             DateTime                @default(now())
  finishedAt            DateTime?
  createdAt             DateTime                @default(now())

  community Community?           @relation("ReconciliationRunCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  creator   AdminUser?           @relation("ReconciliationRunCreator", fields: [tenantId, createdBy], references: [tenantId, id])
  items     ReconciliationItem[]

  @@unique([tenantId, id])
  @@unique([merchantAccountId, businessDate, billType])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([status, leaseExpiresAt])
  @@index([status, startedAt])
  @@index([tenantId, createdBy])
}

model ReconciliationItem {
  id                   String                       @id @default(cuid())
  tenantId             String
  communityId          String?
  runId                String
  paymentId            String?
  refundId             String?
  orderNo              String
  differenceType       ReconciliationDifferenceType
  status               ReconciliationItemStatus     @default(OPEN)
  localAmount          Decimal?                     @db.Decimal(12, 2)
  channelAmount        Decimal?                     @db.Decimal(12, 2)
  differenceAmount     Decimal?                     @db.Decimal(12, 2)
  localStatus          String?
  channelStatus        String?
  channelTransactionId String?
  detailSummary        Json?
  handledBy            String?
  handledAt            DateTime?
  handlingRemark       String?
  createdAt            DateTime                     @default(now())

  run       ReconciliationRun @relation(fields: [tenantId, runId], references: [tenantId, id])
  payment   Payment?          @relation(fields: [tenantId, paymentId], references: [tenantId, id])
  refund    Refund?           @relation(fields: [tenantId, refundId], references: [tenantId, id])
  community Community?        @relation("ReconciliationItemCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  handler   AdminUser?        @relation("ReconciliationItemHandler", fields: [tenantId, handledBy], references: [tenantId, id])

  @@unique([runId, orderNo, differenceType])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([paymentId])
  @@index([refundId])
  @@index([status])
  @@index([tenantId, handledBy])
}

model AuditLog {
  id            String         @id @default(cuid())
  tenantId      String
  communityId   String?
  actorType     AuditActorType @default(SYSTEM)
  actorId       String?
  action        AuditAction
  resourceType  String
  resourceId    String
  reason        String?
  requestId     String?
  ip            String?
  userAgent     String?
  beforeSummary Json?
  afterSummary  Json?
  createdAt     DateTime       @default(now())

  tenant    Tenant     @relation("AuditLogTenant", fields: [tenantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  community Community? @relation("AuditLogCommunity", fields: [tenantId, communityId], references: [tenantId, id], onUpdate: Restrict, map: "AuditLog_tenantId_communityId_restrict_fkey")

  @@index([tenantId, createdAt])
  @@index([tenantId, communityId, createdAt])
  @@index([resourceType, resourceId])
  @@index([requestId])
  @@index([actorId, createdAt])
}

model PaymentEvent {
  id             String             @id @default(cuid())
  tenantId       String
  communityId    String?
  paymentId      String?
  refundId       String?
  eventKey       String
  type           PaymentEventType
  status         PaymentEventStatus @default(PENDING)
  source         String?
  payloadHash    String?
  summary        Json?
  attempts       Int                @default(0)
  availableAt    DateTime           @default(now())
  claimOwner     String?
  claimExpiresAt DateTime?
  processedAt    DateTime?
  lastError      String?
  occurredAt     DateTime           @default(now())
  createdAt      DateTime           @default(now())

  payment   Payment?   @relation(fields: [tenantId, paymentId], references: [tenantId, id], onUpdate: Restrict)
  refund    Refund?    @relation(fields: [tenantId, refundId], references: [tenantId, id], onUpdate: Restrict)
  community Community? @relation("PaymentEventCommunity", fields: [tenantId, communityId], references: [tenantId, id])

  @@unique([tenantId, eventKey])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([paymentId, occurredAt])
  @@index([refundId, occurredAt])
  @@index([status, availableAt])
  @@index([type, occurredAt])
}

model IdempotencyRecord {
  id             String            @id @default(cuid())
  tenantId       String
  communityId    String?
  actorKey       String
  action         String
  requestId      String
  status         IdempotencyStatus @default(PROCESSING)
  requestHash    String
  responseCode   Int?
  responseBody   Json?
  errorCode      String?
  errorMessage   String?
  attempts       Int               @default(0)
  claimOwner     String?
  claimExpiresAt DateTime?
  nextRetryAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  community Community? @relation("IdempotencyCommunity", fields: [tenantId, communityId], references: [tenantId, id])

  @@unique([tenantId, actorKey, action, requestId])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([status, claimExpiresAt])
  @@index([status, nextRetryAt])
  @@index([expiresAt])
}

model OutboxEvent {
  id             String            @id @default(cuid())
  tenantId       String
  communityId    String?
  aggregateType  String
  aggregateId    String
  eventType      String
  dedupKey       String
  payload        Json
  status         OutboxEventStatus @default(PENDING)
  attempts       Int               @default(0)
  availableAt    DateTime          @default(now())
  claimOwner     String?
  claimExpiresAt DateTime?
  lastAttemptAt  DateTime?
  publishedAt    DateTime?
  lastError      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  community Community? @relation("OutboxCommunity", fields: [tenantId, communityId], references: [tenantId, id])

  @@unique([tenantId, dedupKey])
  @@index([tenantId, status, availableAt])
  @@index([tenantId, availableAt, createdAt, id])
  @@index([status, claimExpiresAt])
  @@index([tenantId, communityId])
  @@index([aggregateType, aggregateId])
}

model InvoiceApplication {
  id                 String                   @id @default(cuid())
  tenantId           String
  communityId        String
  paymentId          String
  wxUserId           String
  applicationNo      String                   @unique
  titleType          InvoiceTitleType
  title              String
  taxNo              String?
  deliveryMethod     String
  email              String?
  amount             Decimal                  @db.Decimal(12, 2)
  status             InvoiceApplicationStatus @default(SUBMITTED)
  invoiceNo          String?                  @unique
  invoiceUrl         String?
  processedBy        String?
  appliedAt          DateTime                 @default(now())
  issuedAt           DateTime?
  rejectedAt         DateTime?
  rejectReason       String?
  reversalRequiredAt DateTime?
  reversedAt         DateTime?
  reversalRemark     String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @default(now()) @updatedAt

  payment   Payment    @relation(fields: [tenantId, paymentId], references: [tenantId, id])
  community Community  @relation("InvoiceCommunity", fields: [tenantId, communityId], references: [tenantId, id])
  wxUser    WxUser     @relation(fields: [wxUserId], references: [id])
  processor AdminUser? @relation("InvoiceProcessor", fields: [tenantId, processedBy], references: [tenantId, id])

  @@unique([tenantId, paymentId])
  @@index([tenantId])
  @@index([tenantId, communityId])
  @@index([wxUserId])
  @@index([status, appliedAt])
  @@index([tenantId, processedBy])
}

model PlatformCollectionPolicy {
  id        String                 @id @default(cuid())
  code      String                 @unique
  name      String
  status    CollectionPolicyStatus @default(OPEN)
  changedBy String?
  reason    String?
  changedAt DateTime               @default(now())
  resumeAt  DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @default(now()) @updatedAt

  changer        AdminUser?               @relation("PlatformPolicyChanger", fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tenantPolicies TenantCollectionPolicy[]

  @@index([changedBy])
  @@index([status, resumeAt])
}

model TenantCollectionPolicy {
  id               String                 @id @default(cuid())
  tenantId         String                 @unique
  platformPolicyId String?
  status           CollectionPolicyStatus @default(OPEN)
  changedBy        String?
  reason           String?
  changedAt        DateTime               @default(now())
  resumeAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @default(now()) @updatedAt

  tenant            Tenant                      @relation(fields: [tenantId], references: [id])
  platformPolicy    PlatformCollectionPolicy?   @relation(fields: [platformPolicyId], references: [id], onDelete: SetNull)
  changer           AdminUser?                  @relation("TenantPolicyChanger", fields: [tenantId, changedBy], references: [tenantId, id], onUpdate: Restrict)
  communityPolicies CommunityCollectionPolicy[]

  @@unique([tenantId, id])
  @@index([platformPolicyId])
  @@index([tenantId, status, resumeAt])
  @@index([tenantId, changedBy])
}

model CommunityCollectionPolicy {
  id             String                 @id @default(cuid())
  tenantId       String
  communityId    String
  tenantPolicyId String?
  status         CollectionPolicyStatus @default(OPEN)
  changedBy      String?
  reason         String?
  changedAt      DateTime               @default(now())
  resumeAt       DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @default(now()) @updatedAt

  community    Community               @relation(fields: [tenantId, communityId], references: [tenantId, id])
  tenantPolicy TenantCollectionPolicy? @relation(fields: [tenantId, tenantPolicyId], references: [tenantId, id])
  changer      AdminUser?              @relation("CommunityPolicyChanger", fields: [tenantId, changedBy], references: [tenantId, id], onUpdate: Restrict)

  @@unique([tenantId, communityId])
  @@index([tenantId, status, resumeAt])
  @@index([tenantPolicyId])
  @@index([tenantId, changedBy])
}

model NotifyLog {
  id       String       @id @default(cuid())
  tenantId String
  wxUserId String?
  billId   String?
  type     NotifyType
  channel  String       @default("MOCK") // WX_SUBSCRIBE | MOCK
  status   NotifyStatus
  error    String?
  sentAt   DateTime     @default(now())

  @@index([tenantId])
  @@index([billId, type, status])
  // 通知记录列表按 sentAt desc 排序；NotifyLog 是增长最快的表之一
  // （3000 户 × 3 类提醒 × 1.2 人/月 ≈ 每月 1 万行），无此索引即 filesort
  @@index([tenantId, sentAt])
}

// ---------- 二期：工单 / 访客 / 公告 ----------

enum TicketType {
  REPAIR
  COMPLAINT
  SUGGESTION
}

enum TicketStatus {
  PENDING
  PROCESSING
  DONE
  CLOSED
}

enum PassStatus {
  ACTIVE
  USED
  EXPIRED
  CANCELED
}

enum AnnouncementStatus {
  PUBLISHED
  REVOKED
}

model Ticket {
  id            String       @id @default(cuid())
  tenantId      String
  communityId   String
  houseId       String
  wxUserId      String
  type          TicketType
  content       String       @db.Text
  images        Json // 图片 URL 数组
  status        TicketStatus @default(PENDING)
  assigneeName  String?
  replyContent  String?      @db.Text
  processedAt   DateTime?
  doneAt        DateTime?
  rating        Int? // 完成后业主评分 1-5
  ratingComment String?
  createdAt     DateTime     @default(now())

  house  House  @relation(fields: [houseId], references: [id])
  wxUser WxUser @relation(fields: [wxUserId], references: [id])

  @@index([tenantId])
  @@index([houseId])
  @@index([status])
}

model VisitorPass {
  id           String     @id @default(cuid())
  tenantId     String
  communityId  String
  houseId      String
  wxUserId     String
  visitorName  String
  visitorPhone String?
  plateNo      String?
  visitDate    DateTime // 到访日（当天有效）
  code         String // 6 位数字通行码
  status       PassStatus @default(ACTIVE)
  usedAt       DateTime?
  createdAt    DateTime   @default(now())

  house House @relation(fields: [houseId], references: [id])

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([visitDate])
}

model Announcement {
  id          String             @id @default(cuid())
  tenantId    String
  communityId String? // null = 公司全部小区
  title       String
  content     String             @db.Text
  pinned      Boolean            @default(false)
  status      AnnouncementStatus @default(PUBLISHED)
  createdBy   String?
  publishedAt DateTime           @default(now())

  @@index([tenantId])
  // 业主端每次进首页都查：状态 + 置顶 + 发布时间
  @@index([tenantId, status, pinned, publishedAt])
}

// ---------- 三期：工作照片墙 / 生活服务 / 卡券 ----------

enum WorkCategory {
  INSPECTION // 日常巡检
  CLEANING // 保洁
  GREENING // 绿化
  SECURITY // 安保
  REPAIR // 维修
  OTHER // 其他
}

enum ServiceOrderStatus {
  PENDING // 待接单
  ACCEPTED // 已接单
  DONE // 已完成
  CANCELED // 已取消
}

enum CouponType {
  DISCOUNT // 满减/抵扣（可抵物业费）
  SERVICE // 服务券（免上门费等）
  GIFT // 礼品券
}

enum UserCouponStatus {
  UNUSED
  USED
  EXPIRED
}

model WorkLog {
  id          String       @id @default(cuid())
  tenantId    String
  communityId String
  category    WorkCategory @default(OTHER)
  title       String?
  description String?      @db.Text
  images      Json // 图片 URL 数组
  staffName   String?
  createdBy   String?
  createdAt   DateTime     @default(now())

  @@index([tenantId])
  @@index([communityId])
}

model ServiceItem {
  id          String   @id @default(cuid())
  tenantId    String
  communityId String? // null = 公司全部小区
  name        String
  category    String?
  price       Decimal  @db.Decimal(10, 2)
  unit        String   @default("元/次")
  description String?  @db.Text
  coverImage  String?
  enabled     Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  orders ServiceOrder[]

  @@index([tenantId])
}

model ServiceOrder {
  id            String             @id @default(cuid())
  tenantId      String
  communityId   String
  houseId       String
  wxUserId      String
  serviceItemId String
  serviceName   String // 快照
  price         Decimal            @db.Decimal(10, 2) // 快照
  unit          String // 快照
  contactName   String
  contactPhone  String
  expectDate    DateTime
  remark        String?
  status        ServiceOrderStatus @default(PENDING)
  acceptedAt    DateTime?
  doneAt        DateTime?
  createdAt     DateTime           @default(now())

  house       House       @relation(fields: [houseId], references: [id])
  serviceItem ServiceItem @relation(fields: [serviceItemId], references: [id])

  @@index([tenantId])
  @@index([houseId])
  @@index([status])
}

model Coupon {
  id           String     @id @default(cuid())
  tenantId     String
  communityId  String? // null = 公司全部小区
  name         String
  type         CouponType @default(DISCOUNT)
  faceValue    Decimal?   @db.Decimal(10, 2) // 抵扣/面额
  threshold    Decimal?   @db.Decimal(10, 2) // 满减门槛
  description  String?    @db.Text
  totalQty     Int // 发行总量
  claimedQty   Int        @default(0)
  perUserLimit Int        @default(1)
  validFrom    DateTime
  validTo      DateTime
  enabled      Boolean    @default(true)
  /// 自动发放规则(null = 业主自领)。形如 {minAmount?, requireOnTime?, requireNoArrears?},
  /// 业主线上缴费成功时逐条核对,全中即发(仍受总量/限领约束)。见 CouponsService.autoGrantOnPayment
  autoGrant    Json?
  createdAt    DateTime   @default(now())

  userCoupons UserCoupon[]

  @@index([tenantId])
}

model UserCoupon {
  id        String           @id @default(cuid())
  tenantId  String
  couponId  String
  wxUserId  String
  code      String // 核销码
  status    UserCouponStatus @default(UNUSED)
  claimedAt DateTime         @default(now())
  usedAt    DateTime?
  /// 这是该用户对该券领的第几张（从 0 起）。配合下面的唯一约束把「每人限领」
  /// 变成插入冲突 —— 应用层的 count 校验挡不住并发（TOCTOU），而券是钱。
  claimSeq  Int              @default(0)

  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([tenantId, code])
  @@unique([couponId, wxUserId, claimSeq])
  @@index([tenantId])
  @@index([wxUserId])
}

// ---------- 运营告警与事件（灰度）----------

model OperationalAlert {
  id          String        @id @default(cuid())
  tenantId    String
  communityId String?
  alertType   String
  severity    AlertSeverity @default(WARNING)
  dedupKey    String
  title       String
  summary     String?       @db.Text
  context     Json?
  status      AlertStatus   @default(OPEN)
  occurrences Int           @default(1)
  incidentId  String?
  firstSeenAt DateTime      @default(now())
  lastSeenAt  DateTime      @default(now())
  deliveredAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  incident Incident?      @relation(fields: [tenantId, incidentId], references: [tenantId, id])
  attempts AlertAttempt[]

  @@unique([tenantId, dedupKey])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, severity])
  @@index([tenantId, communityId])
  @@index([tenantId, incidentId])
}

model AlertAttempt {
  id         String   @id @default(cuid())
  tenantId   String
  alertId    String
  attemptNo  Int
  channel    String   @default("WEBHOOK")
  success    Boolean  @default(false)
  statusCode Int?
  error      String?
  createdAt  DateTime @default(now())

  alert OperationalAlert @relation(fields: [tenantId, alertId], references: [tenantId, id])

  @@unique([tenantId, alertId, attemptNo])
  @@index([tenantId])
  @@index([tenantId, alertId])
}

model Incident {
  id             String         @id @default(cuid())
  tenantId       String
  communityId    String?
  dedupKey       String
  title          String
  severity       AlertSeverity  @default(CRITICAL)
  status         IncidentStatus @default(OPEN)
  occurrences    Int            @default(1)
  openedAt       DateTime       @default(now())
  lastSeenAt     DateTime       @default(now())
  acknowledgedAt DateTime?
  acknowledgedBy String?
  resolvedAt     DateTime?
  resolvedBy     String?
  reason         String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  alerts OperationalAlert[]

  @@unique([tenantId, dedupKey])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, communityId])
}
