/*
 * ── 设计尺度（颜色）──
 *
 * 此前小程序端一个变量都没有（后台早有 tokens.css），54 种色值散落在 14 个页面里，
 * 光文字色就有 28 种 —— 六个近似灰全部用在同一个语义上（正文次要文字），
 * 于是每页的文字颜色都略有不同，整体看着不干净。
 *
 * 这一步**刻意只做零风险的一半**：把重复出现的色值收进具名变量，取值一个不改。
 * 用 var(--x, #原值) 的带回退写法 —— 变量生效就走 token，
 * 万一某个基础库不支持自定义属性也退回原值，两种情况下观感都完全不变。
 * （已用逐字节比对截图验证：8 个页面改动前后的 PNG 完全一致。）
 *
 * 真正的**归并**（比如把 --text-3 #7c7288 与 --text-4 #8b8199 合成一档）没有做：
 * 那会改变 54 处的观感，必须在真机上逐页比对才能定，不能靠近似渲染拍板。
 * 归并时只需改这里的一行，不必再翻 14 个文件 —— 这就是这一步的价值。
 *
 * 未进入尺度的 35 种色值各出现 ≤6 次（多为渐变端点），留待同一次真机审查。
 */
page {
  /* 文字：由深到浅。--text-3 / --text-4 是同一语义的两种历史取值，待合并 */
  --text: #251c38;
  --text-2: #55496b;
  --text-3: #7c7288;
  --text-4: #8b8199;
  --text-5: #a79eb5;
  --text-6: #9a92a3;

  /* 金：品牌色，用于强调、按钮与徽章 */
  --gold: #c9a66b;
  --gold-ink: #9b743a;
  --gold-deep: #b8862f;
  --gold-pale: #ead0a0;

  /* 底与纸面 */
  --cream: #faf7f2;
  --cream-2: #fdfbf7;
  --note: #fff1c8;
  --white: #fff;

  /* 深色卡面 */
  --ink-deep: #2e1a47;
  --plum: #3b2b57;
  --plum-2: #5a4680;

  /* 语义 */
  --danger: #c45656;
  --success: #3f7d5d;
}

page {
  min-height: 100vh;
  color: var(--text, #251c38);
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  background: radial-gradient(circle at 12% 8%, rgba(201, 166, 107, 0.16), transparent 28%), linear-gradient(180deg, var(--cream, #faf7f2) 0%, #f5f1ec 100%);
}

view, text, button {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  border: 0;
  line-height: 1;
  background: transparent;
  font-family: inherit;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 88rpx 32rpx 40rpx;
  background: radial-gradient(circle at 86% 2%, rgba(90, 70, 128, 0.18), transparent 32%), linear-gradient(180deg, var(--cream-2, #fdfbf7) 0%, #f5f1ec 72%, #ebe5df 100%);
}

.nav-title {
  font-size: 42rpx;
  line-height: 1.15;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: var(--text, #251c38);
}

.nav-subtitle {
  margin-top: 10rpx;
  color: var(--text-4, #8b8199);
  font-size: 24rpx;
}

/*
 * 禁用态。
 *
 * 全仓原本没有任何 [disabled] 样式，而这些按钮用自定义类覆盖了 background ——
 * 微信原生的置灰被盖掉，**禁用的按钮和可点的按钮长得一模一样**。
 * 受影响的有 5 处：缴费确认（该账单已缴清 / 收款已暂停 / 上笔支付进行中）、
 * 保存收据、提交工单、预约服务、提交评价。
 *
 * 缴费确认那处最要紧：它没有 loading 转圈，只靠文案变化表达状态，
 * 而按钮看着完全可点 —— 业主会反复点一个不会响应的主按钮。
 *
 * 只降透明度并去掉投影，不改颜色：保持与可点态是同一个按钮，
 * 一眼看出「是它，但现在不能按」。
 */
.gold-button[disabled],
.dark-button[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

.card {
  border-radius: 42rpx;
  background: rgba(253, 251, 247, 0.86);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 28rpx 70rpx rgba(70, 52, 29, 0.1);
}

.gold-button {
  height: 88rpx;
  padding: 0 38rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text, #251c38);
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold, #c9a66b));
  box-shadow: 0 18rpx 38rpx rgba(155, 116, 58, 0.24);
}

.dark-button {
  height: 88rpx;
  padding: 0 38rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cream-2, #fdfbf7);
  font-size: 28rpx;
  font-weight: 800;
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  box-shadow: 0 18rpx 38rpx rgba(37, 28, 56, 0.2);
}

.muted {
  color: var(--text-3, #7c7288);
}

.amount {
  font-family: DIN Alternate, SF Pro Display, Arial, sans-serif;
  letter-spacing: -1rpx;
}

/* ---- 自定义导航（四个 tab 页共用，标题行与系统胶囊同行对齐） ---- */
.page.has-navbar {
  padding-top: 0;
  /*
   * tab 页底部要多留一点，避免最后一张卡片贴着 tabBar。
   * 原先 index/bill/mine 各自写了一遍 padding-bottom: 48rpx，
   * 而第四个 tab 页 service-hall 的 .hall-page 规则压根没写（类名却已挂上），
   * 于是它比另外三个少 8rpx——这类零散差异累积起来就是「整体性差一点」。
   */
  padding-bottom: 48rpx;
}

.nav-row {
  display: flex;
  align-items: center;
}

.nav-row-title {
  font-size: 36rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: var(--text, #251c38);
  /* 右侧空间留给系统胶囊 */
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.nav-sub-row {
  margin-top: 10rpx;
  color: var(--text-4, #8b8199);
  font-size: 24rpx;
}

/* ---- 通用三态：加载 / 错误 / 空（全站复用） ---- */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx;
  text-align: center;
}

.state-spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid rgba(37, 28, 56, 0.12);
  border-top-color: var(--gold, #c9a66b);
  border-radius: 50%;
  animation: state-spin 0.8s linear infinite;
}

@keyframes state-spin {
  to { transform: rotate(360deg); }
}

.state-icon {
  font-size: 72rpx;
  opacity: 0.5;
  line-height: 1;
}

.state-text {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-4, #8b8199);
}

.state-retry {
  margin-top: 30rpx;
  padding: 0 52rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: var(--text, #251c38);
  background: rgba(201, 166, 107, 0.18);
  border-radius: 40rpx;
}

.state-cta {
  margin-top: 30rpx;
}

/* 未绑定房屋提示条（表单页顶部复用） */
.bind-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}

.bb-text {
  font-size: 26rpx;
  color: #8b5e00;
  flex: 1;
}

.bb-btn {
  height: 60rpx;
  padding: 0 30rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

/*
 * 列表页脚（4 个分页列表共用）。
 *
 * loadingMore 此前在 bill / payments / tickets / work-wall 四页都只作为 JS 里的
 * 防重入标记，模板零引用——业主往下拉时看不到任何反馈，不知道是在加载还是到底了。
 * .list-end 原先只在 bill.wxss 里有一份，其余三页连「已显示全部」都没有。
 */
.list-loading,
.list-end {
  text-align: center;
  color: #ada4bd;
  font-size: 22rpx;
  padding: 14rpx 0 6rpx;
}
