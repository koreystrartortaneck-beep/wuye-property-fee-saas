/*
 * 管理端公共样式(分包内 @import 共享)。
 *
 * 刻意做得比业主端「大」:字大、行高、按钮大 ——
 * 用的人不熟悉手机操作,首要目标是「看得清、点得准」,不是精致。
 * 沿用业主端的设计令牌(app.wxss 的 --text/--gold 等),视觉同族。
 */

.adm-page {
  padding: 32rpx 28rpx 60rpx;
}

.adm-hello {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text, #251c38);
  margin-bottom: 20rpx;
}

.adm-search {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.06);
  font-size: 30rpx;
  box-sizing: border-box;
}

.adm-section {
  margin: 36rpx 4rpx 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-2, #55496b);
}

.adm-card {
  margin-top: 16rpx;
  border-radius: 28rpx;
  background: rgba(253, 251, 247, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  padding: 6rpx 24rpx;
}

.adm-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 108rpx;
  padding: 14rpx 4rpx;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.06);
}
.adm-row:last-child {
  border-bottom: none;
}
.adm-row-hover {
  background: rgba(37, 28, 56, 0.04);
}
.adm-row-main {
  flex: 1;
  min-width: 0;
}
.adm-row-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}
.adm-row-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--text-3, #7c7288);
}
.adm-arrow {
  flex-shrink: 0;
  font-size: 44rpx;
  color: var(--gold, #c9a66b);
}
.adm-badge {
  flex-shrink: 0;
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--danger, #c45656);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.adm-hint {
  margin: 18rpx 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-3, #7c7288);
}

.adm-stats {
  display: flex;
  padding: 24rpx;
  gap: 24rpx;
}
.adm-stat {
  flex: 1;
}
.adm-stat-num {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.adm-danger {
  color: var(--danger, #c45656);
}
.adm-stat-label {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: var(--text-3, #7c7288);
}

/* 大按钮:一屏一个主动作 */
.adm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--cream-2, #fdfbf7);
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
}
.adm-btn-ghost {
  color: var(--text, #251c38);
  background: rgba(37, 28, 56, 0.06);
}
.adm-btn-danger {
  background: linear-gradient(145deg, #d06a6a, var(--danger, #c45656));
}
.adm-btn-busy {
  opacity: 0.6;
}

.adm-denied {
  margin-top: 200rpx;
  text-align: center;
  padding: 0 40rpx;
}
.adm-denied-title {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.adm-denied-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-3, #7c7288);
}
