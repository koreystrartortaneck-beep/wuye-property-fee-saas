/*
 * 管理端设计语言 · 方案 A「暖调同族」
 *
 * 与业主端同一套暖紫金色系(app.wxss 的令牌),整个小程序里外一家人 ——
 * 物业人员和业主用的是同一个小程序,视觉断层会让人以为进错了地方。
 *
 * 三条尺度纪律(用的人不熟悉手机操作):
 *   · 可点区域 ≥ 88rpx 高
 *   · 正文 ≥ 26rpx,关键数字 ≥ 40rpx
 *   · 一屏一个主动作,主动作永远是深紫实心
 */

page {
  background: linear-gradient(180deg, #efe7dc, #f6f0e7 30%);
}

.adm-page {
  padding: 24rpx 24rpx 60rpx;
}

/* ── 卡片 ── */
.adm-card {
  border-radius: 32rpx;
  background: rgba(253, 251, 247, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 20rpx 50rpx rgba(70, 52, 29, 0.08);
  padding: 8rpx 26rpx;
}
.adm-sec {
  margin: 34rpx 8rpx 14rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-2, #55496b);
}

/* ── 列表行 ── */
.adm-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.05);
}
.adm-row:last-child {
  border-bottom: none;
}
.adm-row-hover {
  background: rgba(37, 28, 56, 0.03);
}
.adm-row-main {
  flex: 1;
  min-width: 0;
}
.adm-row-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}
.adm-row-sub {
  margin-top: 3rpx;
  font-size: 24rpx;
  color: var(--text-3, #7c7288);
}
.adm-arrow {
  flex-shrink: 0;
  font-size: 44rpx;
  line-height: 1;
  color: var(--gold, #c9a66b);
}

/* ── 徽标与胶囊 ── */
.adm-badge {
  flex-shrink: 0;
  min-width: 52rpx;
  height: 52rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--danger, #c45656);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.adm-pill {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
}
.adm-pill-quiet {
  background: rgba(90, 70, 128, 0.08);
  color: var(--plum, #3b2b57);
}
.adm-pill-danger {
  background: rgba(196, 86, 86, 0.09);
  color: var(--danger, #c45656);
}
.adm-pill-ok {
  background: rgba(101, 163, 88, 0.12);
  color: #4f7d44;
}

/* ── 按钮:一屏一个主动作 ── */
.adm-btn {
  height: 96rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--cream-2, #fdfbf7);
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  box-shadow: 0 16rpx 36rpx rgba(37, 28, 56, 0.22);
}
.adm-btn-ghost {
  color: var(--text, #251c38);
  background: rgba(37, 28, 56, 0.06);
  box-shadow: none;
}
.adm-btn-gold {
  color: var(--text, #251c38);
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold, #c9a66b));
  box-shadow: 0 16rpx 36rpx rgba(155, 116, 58, 0.22);
}
.adm-btn-busy {
  opacity: 0.55;
}
.adm-link {
  padding: 24rpx 0 20rpx;
  text-align: center;
  font-size: 27rpx;
  font-weight: 800;
  color: var(--gold-deep, #b8862f);
}

/* ── 输入 ── */
.adm-search {
  width: 100%;
  height: 96rpx;
  padding: 0 32rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.06);
  font-size: 29rpx;
  box-sizing: border-box;
}
.adm-input {
  height: 88rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 28rpx;
  box-sizing: border-box;
}

/* ── 提示 ── */
.adm-hint {
  margin: 18rpx 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-3, #7c7288);
}
.adm-error {
  color: var(--danger, #c45656);
  font-weight: 700;
}
.adm-num {
  /* 数字等宽:金额成列时不跳动 */
  font-variant-numeric: tabular-nums;
}
.adm-danger {
  color: var(--danger, #c45656);
}

.adm-denied {
  margin-top: 180rpx;
  text-align: center;
  padding: 0 40rpx;
}
.adm-denied-title {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.adm-denied-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-3, #7c7288);
}
.adm-retry {
  margin: 40rpx auto 0;
  width: 320rpx;
}

/* ── 分段标签:一屏一件事,角标告诉你哪块有事 ── */
.tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
}
.tab {
  flex: 1;
  height: 76rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-2, #55496b);
}
.tab-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  color: var(--cream-2, #fdfbf7);
  box-shadow: 0 8rpx 22rpx rgba(37, 28, 56, 0.22);
}
.tab-bd {
  min-width: 30rpx;
  height: 30rpx;
  line-height: 30rpx;
  margin-left: 6rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--danger, #c45656);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
}
.tab-on .tab-bd { background: rgba(253, 251, 247, 0.9); color: var(--plum, #3b2b57); }
