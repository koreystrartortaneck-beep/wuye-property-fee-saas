<view class="page adm-page">
  <view wx:if="{{loading}}" class="adm-hint">加载中…</view>
  <view wx:elif="{{items.length === 0}}" class="adm-denied">
    <view class="adm-denied-title">没有待审批的申请 ✓</view>
    <view class="adm-denied-desc">业主自助申请绑定后会出现在这里</view>
  </view>

  <view class="adm-card" wx:for="{{items}}" wx:key="id">
    <view class="ap-house">{{item.houseName}}<text class="ap-code"> {{item.houseCode}}</text></view>
    <view class="ap-who">
      申请人:{{item.applicant}} · {{item.relation}}
      <text wx:if="{{item.phone}}" class="ap-phone" data-phone="{{item.phone}}" bindtap="callPhone"> {{item.phone}} 📞</text>
    </view>
    <view class="adm-hint">核对要点:姓名与物业登记是否一致;拿不准就打电话问</view>
    <view class="ap-actions">
      <view class="adm-btn adm-btn-ghost ap-btn {{busy === item.id ? 'adm-btn-busy' : ''}}" data-id="{{item.id}}" bindtap="reject">驳回</view>
      <view class="adm-btn ap-btn {{busy === item.id ? 'adm-btn-busy' : ''}}" data-id="{{item.id}}" bindtap="approve">通过</view>
    </view>
  </view>
</view>
