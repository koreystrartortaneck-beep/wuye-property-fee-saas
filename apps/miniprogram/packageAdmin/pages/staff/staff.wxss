@import "../../adm.wxss";

.st-row {
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.05);
}
.st-row:last-child { border-bottom: none; }
.st-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 88rpx;
}
.st-role {
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(90, 70, 128, 0.08);
  color: var(--plum, #3b2b57);
  font-size: 20rpx;
  font-weight: 700;
}
.st-role-admin {
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold, #c9a66b));
  color: var(--text, #251c38);
}
.st-me {
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(101, 163, 88, 0.14);
  color: #4f7d44;
  font-size: 20rpx;
  font-weight: 700;
}
.st-acts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.st-acts .adm-pill {
  height: 64rpx;
  display: flex;
  align-items: center;
}

/* 表单 */
.f-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.05);
}
.f-lab {
  flex: 0 0 150rpx;
  font-size: 27rpx;
  color: var(--text-2, #55496b);
}
.req { color: var(--danger, #c45656); }
.f-in { flex: 1; min-width: 0; }

/* 角色选择:把差别写在选项里,而不是让人去猜 */
.r-pick {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin: 20rpx 0 4rpx;
}
.r-item {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(37, 28, 56, 0.04);
  border: 2rpx solid transparent;
}
.r-on {
  background: rgba(90, 70, 128, 0.08);
  border-color: rgba(90, 70, 128, 0.45);
}
.r-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}
.r-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: var(--text-3, #7c7288);
}
.two-btn { display: flex; gap: 16rpx; margin-top: 26rpx; }
.half { flex: 1; }
.add-btn { color: var(--gold-deep, #b8862f); }
