<view class="page adm-page">
  <view wx:if="{{loading}}" class="adm-hint">加载中…</view>
  <view wx:elif="{{loadError}}" class="adm-denied">
    <view class="adm-denied-title">加载失败</view>
    <view class="adm-denied-desc">请检查网络后重试</view>
    <view class="adm-btn adm-retry" bindtap="load">重试</view>
  </view>

  <block wx:elif="{{house}}">
    <!-- 头卡:这是哪一户、欠多少,一眼可见 -->
    <view class="hero">
      <view class="hero-name">{{house.displayName}}</view>
      <view class="hero-meta">{{house.code}} · {{house.communityName}}<text wx:if="{{house.area}}"> · {{house.area}}㎡</text></view>
      <view class="hero-figs">
        <view class="fig">
          <view class="fig-num {{summary.unpaidCount > 0 ? 'fig-warn' : ''}} adm-num">¥{{summary.unpaidAmount}}</view>
          <view class="fig-lab">待缴 {{summary.unpaidCount}} 笔</view>
        </view>
        <view class="fig-div"></view>
        <view class="fig">
          <view class="fig-num adm-num">¥{{summary.paidAmount}}</view>
          <view class="fig-lab">已缴 {{summary.paidCount}} 笔</view>
        </view>
      </view>
    </view>

    <!-- 房屋信息:面积与放户日期直接决定账单,所以就摆在最上面并且可改 -->
    <view class="adm-sec">
      房屋信息
      <text wx:if="{{!editing}}" class="sec-act" bindtap="startEdit">编辑</text>
    </view>
    <view class="adm-card">
      <block wx:if="{{!editing}}">
        <view class="adm-row">
          <view class="adm-row-main"><view class="adm-row-sub">房号</view></view>
          <view class="adm-row-title">{{house.displayName}}</view>
        </view>
        <view class="adm-row">
          <view class="adm-row-main"><view class="adm-row-sub">建筑面积</view></view>
          <view class="adm-row-title adm-num">{{house.area ? house.area + ' ㎡' : '未填'}}</view>
        </view>
        <view class="adm-row">
          <view class="adm-row-main">
            <view class="adm-row-sub">放户日期</view>
            <view class="adm-row-sub">{{billMonthText}}</view>
          </view>
          <view class="adm-row-title adm-num {{house.handoverDate ? '' : 'adm-danger'}}">{{house.handoverDate || '未填'}}</view>
        </view>
        <view class="adm-row">
          <view class="adm-row-main"><view class="adm-row-sub">状态</view></view>
          <view class="adm-pill {{house.status === 'ACTIVE' ? 'adm-pill-ok' : 'adm-pill-quiet'}}">{{house.status === 'ACTIVE' ? '在用' : '停用'}}</view>
        </view>
      </block>

      <block wx:else>
        <view class="ed-row">
          <view class="ed-lab">房号</view>
          <input class="adm-input ed-in" data-k="displayName" value="{{form.displayName}}" bindinput="onFormInput" />
        </view>
        <view class="ed-row">
          <view class="ed-lab">建筑面积</view>
          <input class="adm-input ed-in" type="digit" data-k="area" value="{{form.area}}" bindinput="onFormInput" placeholder="㎡" />
        </view>
        <view class="ed-row">
          <view class="ed-lab">放户日期</view>
          <picker class="ed-in" mode="date" value="{{form.handoverDate}}" bindchange="onHandover">
            <view class="adm-input pick-line">{{form.handoverDate || '选日期'}} ›</view>
          </picker>
        </view>
        <view class="ed-row">
          <view class="ed-lab">状态</view>
          <view class="seg ed-in">
            <view class="seg-i {{form.status === 'ACTIVE' ? 'seg-on' : ''}}" data-v="ACTIVE" bindtap="pickStatus">在用</view>
            <view class="seg-i {{form.status === 'DISABLED' ? 'seg-on' : ''}}" data-v="DISABLED" bindtap="pickStatus">停用</view>
          </view>
        </view>
        <view class="two-btn ed-btns">
          <view class="adm-btn adm-btn-ghost half" bindtap="cancelEdit">取消</view>
          <view class="adm-btn half {{saving ? 'adm-btn-busy' : ''}}" bindtap="saveHouse">{{saving ? '保存中…' : '保存'}}</view>
        </view>
        <view class="adm-hint">放户日期 = 这户每年该出账的那一天。改了它,以后出账的月份也跟着变。</view>
      </block>
    </view>

    <!-- 收费标准:挂了才出账 -->
    <view class="adm-sec">收费标准(挂了才出账)</view>
    <view class="adm-card">
      <view wx:if="{{standards.length === 0}}" class="adm-hint">没挂标准 —— 这户永远不会出账单(空置/免收就该这样)</view>
      <view class="adm-row" wx:for="{{standards}}" wx:key="ruleId">
        <view class="adm-row-main">
          <view class="adm-row-title">{{item.name}}</view>
          <view class="adm-row-sub">{{item.price}}<text wx:if="{{item.anchorText}}"> · {{item.anchorText}}</text></view>
        </view>
        <view class="adm-pill adm-pill-danger" data-id="{{item.ruleId}}" data-name="{{item.name}}" bindtap="detachRule">摘除</view>
      </view>

      <block wx:if="{{pickingRule}}">
        <view wx:if="{{rules.length === 0}}" class="adm-hint">没有可挂的按年收费标准了(要新建标准请在电脑后台)</view>
        <view class="adm-row" wx:for="{{rules}}" wx:key="id" data-i="{{index}}" bindtap="attachRule" hover-class="adm-row-hover">
          <view class="adm-row-main">
            <view class="adm-row-title">{{item.name}}</view>
            <view class="adm-row-sub">{{item.price}}</view>
          </view>
          <view class="adm-pill adm-pill-quiet">挂上</view>
        </view>
      </block>
      <view class="adm-link" bindtap="togglePickRule">{{pickingRule ? '收起' : '＋ 挂一条收费标准'}}</view>
    </view>

    <!-- 住这套房的人:换绑就在这 -->
    <view class="adm-sec">授权手机号(谁能看到这套房的账单)</view>
    <view class="adm-card">
      <view wx:if="{{contacts.length === 0}}" class="adm-hint">还没有授权任何手机号,在下方添加</view>
      <view class="adm-row" wx:for="{{contacts}}" wx:key="id">
        <view class="avatar">{{item.name ? item.name[0] : '住'}}</view>
        <view class="adm-row-main">
          <view class="adm-row-title">
            {{item.name || '未备注'}}
            <text wx:if="{{item.bound}}" class="tag-on">使用中</text>
          </view>
          <view class="adm-row-sub adm-num">{{item.phone}}</view>
        </view>
        <view class="adm-pill adm-pill-quiet" data-phone="{{item.phone}}" bindtap="callPhone">拨号</view>
        <view class="adm-pill adm-pill-danger" data-id="{{item.id}}" data-phone="{{item.phone}}" bindtap="removeContact">移除</view>
      </view>

      <view class="add-row">
        <input class="adm-input add-phone" type="number" maxlength="11" placeholder="新住户手机号" value="{{newPhone}}" bindinput="onPhoneInput" />
        <input class="adm-input add-name" placeholder="备注姓名" value="{{newName}}" bindinput="onNameInput" />
      </view>
      <view class="adm-link {{adding ? 'adm-btn-busy' : ''}}" bindtap="addContact">＋ 添加授权手机号</view>
    </view>
    <view class="adm-hint">换住户 = 先移除旧号(对方立即看不到账单),再添加新号(对方授权手机号即见账单)</view>

    <!-- 账单:每一行自带这笔钱该做的动作 -->
    <view class="adm-sec">账单</view>
    <view class="adm-card">
      <view wx:if="{{bills.length === 0}}" class="adm-hint">还没有账单</view>
      <view class="bill-row" wx:for="{{bills}}" wx:key="id">
        <view class="bill-line">
          <view class="adm-row-main">
            <view class="adm-row-title">{{item.title}}</view>
            <view class="adm-row-sub adm-num">{{item.periodText}}</view>
          </view>
          <view class="bill-right">
            <view class="adm-row-title adm-num">¥{{item.amount}}</view>
            <view class="bill-st {{item.status === 'UNPAID' ? 'adm-danger' : ''}}">{{item.statusLabel}}</view>
          </view>
        </view>
        <view wx:if="{{item.canCollect || item.canRefund || item.canReverse}}" class="bill-acts">
          <view wx:if="{{item.canCollect}}" class="adm-pill adm-pill-ok" data-id="{{item.id}}" bindtap="goCollect">收到现金 · 登记</view>
          <view wx:if="{{item.canRefund}}" class="adm-pill adm-pill-danger" data-order="{{item.orderNo}}" data-amount="{{item.amount}}" bindtap="refund">退款</view>
          <view wx:if="{{item.canReverse}}" class="adm-pill adm-pill-danger" data-order="{{item.orderNo}}" data-amount="{{item.amount}}" bindtap="reverse">冲正线下收款</view>
        </view>
      </view>
    </view>

    <!-- 停用的房屋不出账:在按钮之前就说,别等人点进去才发现 -->
    <view wx:if="{{house.status !== 'ACTIVE'}}" class="adm-hint adm-error">
      这套房是「停用」状态,系统不会给它出账。要出账单,先在上面「房屋信息 · 编辑」里把状态改成「在用」。
    </view>
    <view class="adm-btn adm-btn-gold act-btn" bindtap="goBillThisHouse">给这户发账单</view>
  </block>
</view>
