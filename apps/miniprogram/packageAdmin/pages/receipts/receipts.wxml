<view class="page adm-page">
  <view class="adm-sticky">
    <input class="adm-search" placeholder="搜索房号 / 收据编号 / 订单号" value="{{keyword}}" bindinput="search" />
    <view class="adm-filters">
      <picker range="{{channels}}" value="{{channelIndex}}" data-key="channelIndex" bindchange="filter"><view>{{channels[channelIndex]}} ▾</view></picker>
      <picker range="{{states}}" value="{{stateIndex}}" data-key="stateIndex" bindchange="filter"><view>{{states[stateIndex]}} ▾</view></picker>
      <picker mode="date" value="{{date}}" bindchange="date"><view>{{date || '全部日期'}} ▾</view></picker>
      <view wx:if="{{date}}" bindtap="clearDate">清除日期</view>
    </view>
    <view class="adm-summary"><view>有效实收 <text class="adm-num">¥{{amount}}</text></view><text>{{total}} 张收据</text></view>
    <view class="adm-pager"><view data-delta="-1" bindtap="turn">上一页</view><text>{{page}} / {{pages}}</text><view data-delta="1" bindtap="turn">下一页</view></view>
  </view>
  <view wx:if="{{loading}}" class="adm-hint">加载中…</view>
  <view wx:elif="{{error}}" class="adm-hint adm-error" bindtap="load">{{error}}</view>
  <block wx:else>
    <view wx:if="{{!rows.length}}" class="adm-empty">暂无收据</view>
    <view class="adm-card receipt-row" wx:for="{{rows}}" wx:key="orderNo" data-order="{{item.orderNo}}" bindtap="open">
      <view class="adm-row"><view class="adm-row-main"><view class="adm-row-title">{{item.name}}</view><view class="adm-row-sub">{{item.title}}</view></view><view class="adm-row-title adm-num">¥{{item.amount}}</view></view>
      <view class="receipt-meta"><text>{{item.status === 'REFUNDED' ? '已作废' : item.channelText}}</text><text>{{item.at}} ›</text></view>
    </view>
  </block>
</view>
