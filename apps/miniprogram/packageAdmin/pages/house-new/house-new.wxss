@import "../../adm.wxss";

.f-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 100rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.05);
}
.f-row:last-child { border-bottom: none; }
.f-lab {
  flex: 0 0 168rpx;
  font-size: 27rpx;
  color: var(--text-2, #55496b);
}
.req { color: var(--danger, #c45656); }
.f-in { flex: 1; min-width: 0; }
.pick-line {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text, #251c38);
}
.seg { display: flex; gap: 10rpx; }
.seg-i {
  flex: 1;
  height: 84rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  background: rgba(37, 28, 56, 0.05);
  color: var(--text-2, #55496b);
}
.seg-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  color: var(--cream-2, #fdfbf7);
}
.em { font-weight: 800; color: var(--text, #251c38); }
.act { margin-top: 30rpx; }

/* 房号 → 楼盘图位置的实时预览 */
.grid-hint {
  margin: 4rpx 0 10rpx 186rpx; /* 对齐输入列(标签 168 + 间距 18) */
  font-size: 24rpx;
  color: var(--text-2, #55496b);
}
.grid-hint-warn { color: var(--danger, #c45656); }
