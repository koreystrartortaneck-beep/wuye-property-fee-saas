@import "../../adm.wxss";
.adm-page {padding-bottom:calc(190rpx + env(safe-area-inset-bottom));}.adm-page .cv-verify {position:fixed;bottom:0;left:0;right:0;margin:0;z-index:6;border-radius:0;height:calc(110rpx + env(safe-area-inset-bottom));padding-bottom:env(safe-area-inset-bottom);}

.cv-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
}
.cv-in { flex: 1; min-width: 0; }
.cv-btn { flex: 0 0 auto; padding: 0 34rpx; }
.adm-btn-dim { opacity: 0.6; }

.cv-found { margin-top: 20rpx; }
.cv-name {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.cv-meta {
  display: flex;
  gap: 12rpx;
  margin: 14rpx 0 6rpx;
}
.cv-line {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--text-2, #55496b);
}
.cv-verify { margin-top: 26rpx; }

.cv-scan { width: 100%; }
.cv-or {
  margin: 20rpx 0 16rpx;
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
  text-align: center;
}
