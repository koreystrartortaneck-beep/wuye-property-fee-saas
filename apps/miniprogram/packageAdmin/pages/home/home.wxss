@import "../../adm.wxss";

/* ── 顶部 ── */
.hd {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 6rpx 4rpx 20rpx;
}
.hd-title {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text, #251c38);
  letter-spacing: 2rpx;
}
.hd-sub {
  font-size: 24rpx;
  color: var(--text-3, #7c7288);
}

/* ── 待办条 ── */
.todo-strip {
  margin-top: 22rpx;
  white-space: nowrap;
}
.todo-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, var(--note, #fff1c8), rgba(201, 166, 107, 0.35));
  border: 1rpx solid rgba(201, 166, 107, 0.4);
}
.todo-count {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--danger, #c45656);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.todo-label {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text, #251c38);
}

/* ── 楼栋条 ── */
.b-strip {
  margin-top: 24rpx;
  white-space: nowrap;
}
.b-chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 16rpx 26rpx;
  border-radius: 22rpx;
  background: rgba(253, 251, 247, 0.9);
  border: 2rpx solid rgba(37, 28, 56, 0.08);
}
.b-chip-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
}
.b-chip-on .b-chip-name {
  color: var(--cream-2, #fdfbf7);
}
.b-chip-on .b-chip-warn,
.b-chip-on .b-chip-ok {
  color: rgba(253, 251, 247, 0.75);
}
.b-chip-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.b-chip-sub {
  margin-top: 2rpx;
  font-size: 21rpx;
}
.b-chip-warn {
  color: var(--danger, #c45656);
  font-weight: 700;
}
.b-chip-ok {
  color: var(--text-4, #8b8199);
}

/* ── 楼盘图 ── */
.unit-title {
  margin: 26rpx 6rpx 10rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-2, #55496b);
}
.grid-card {
  margin-top: 14rpx;
  border-radius: 26rpx;
  background: rgba(253, 251, 247, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  padding: 18rpx 18rpx 10rpx;
}
.floor-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.floor-tag {
  flex: 0 0 64rpx;
  padding-top: 22rpx;
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
  text-align: right;
}
.cells {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cell {
  min-width: 128rpx;
  padding: 12rpx 14rpx;
  border-radius: 16rpx;
  background: rgba(90, 70, 128, 0.07);
  border: 2rpx solid rgba(90, 70, 128, 0.1);
  text-align: center;
  box-sizing: border-box;
}
.cell-hover {
  transform: scale(0.96);
}
.cell-no {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}
.cell-amt {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--danger, #c45656);
}
/* 欠费:红格 —— 颜色即状态,这是楼盘图存在的意义 */
.cell-unpaid {
  background: rgba(196, 86, 86, 0.1);
  border-color: rgba(196, 86, 86, 0.35);
}
.cell-unpaid .cell-no {
  color: var(--danger, #c45656);
}
/* 停用:灰格,存在但不可收费 */
.cell-off {
  opacity: 0.38;
}

/* ── 图例 ── */
.legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 20rpx 8rpx 0;
  font-size: 22rpx;
  color: var(--text-3, #7c7288);
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 6rpx;
  background: rgba(90, 70, 128, 0.15);
}
.legend-dot-unpaid {
  background: rgba(196, 86, 86, 0.45);
}
.legend-dot-off {
  background: rgba(37, 28, 56, 0.12);
}
.legend-tip {
  margin-left: auto;
}

.adm-retry {
  margin: 40rpx auto 0;
  width: 320rpx;
}

.adm-error {
  color: var(--danger, #c45656);
  font-weight: 700;
}
