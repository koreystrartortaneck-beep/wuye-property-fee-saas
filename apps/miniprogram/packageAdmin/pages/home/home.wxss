@import "../../adm.wxss";

/* ── 功能箱:两列卡片,名字大、说明小,一眼找得到按钮 ── */
.tools {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 22rpx;
}
.tool {
  width: calc((100% - 18rpx) / 2);
  box-sizing: border-box;
  padding: 30rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, var(--white, #fff), #f8f4ed);
  border: 1rpx solid rgba(59, 43, 87, 0.1);
  box-shadow: 0 6rpx 18rpx rgba(70, 52, 29, 0.05), inset 0 1rpx 0 var(--white, #fff);
}
.tool-main {
  width: 100%;
  background: linear-gradient(150deg, #4a3768, var(--plum, #3b2b57) 45%, #2c2043);
  border-color: rgba(201, 166, 107, 0.55);
}
.tool-main .tool-name { color: var(--cream-2, #fdfbf7); }
.tool-main .tool-desc { color: rgba(253, 251, 247, 0.66); }
.tool-name {
  font-size: 31rpx;
  font-weight: 900;
  color: var(--text, #251c38);
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.tool-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-4, #8b8199);
}

/* ── 楼栋条 ── */
.b-strip {
  margin-top: 22rpx;
  white-space: nowrap;
}
.b-chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 16rpx 28rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #ffffff, #f8f4ed);
  border: 1rpx solid rgba(59, 43, 87, 0.1);
  box-shadow: 0 6rpx 18rpx rgba(70, 52, 29, 0.06), inset 0 1rpx 0 #ffffff;
}
.b-chip-on {
  background: linear-gradient(150deg, #4a3768, var(--plum, #3b2b57) 45%, #2c2043);
  border: 1rpx solid rgba(201, 166, 107, 0.55);
  box-shadow: 0 10rpx 26rpx rgba(59, 43, 87, 0.28);
}
.b-chip-on .b-chip-name { color: var(--cream-2, #fdfbf7); }
.b-chip-on .b-chip-warn,
.b-chip-on .b-chip-ok { color: rgba(253, 251, 247, 0.72); }
.b-chip-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.b-chip-sub { margin-top: 2rpx; font-size: 21rpx; }
.b-chip-warn { color: var(--danger, #c45656); font-weight: 700; }
.b-chip-ok { color: var(--text-4, #8b8199); }

/* ── 单元卡 + 楼层格 ── */
.unit-card {
  margin-top: 24rpx;
  border-radius: 32rpx;
  background: rgba(253, 251, 247, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 20rpx 50rpx rgba(70, 52, 29, 0.08);
  padding: 26rpx 24rpx;
}
.unit-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.unit-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.unit-name::before {
  content: '';
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, var(--gold, #c9a66b), var(--gold-deep, #b8862f));
}
.unit-legend {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: var(--text-4, #8b8199);
}
/* 图例的小色样与格子实际用色一致 —— 图例骗人比没有图例更糟 */
.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #ffffff, #f4efe6);
  border: 1rpx solid rgba(59, 43, 87, 0.14);
}
.dot-r {
  background: linear-gradient(180deg, #fdf0ee, #f6dedb);
  border-color: rgba(196, 86, 86, 0.45);
}
.dot-g {
  background: transparent;
  border: 1rpx dashed rgba(37, 28, 56, 0.3);
}

.frow {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding-bottom: 14rpx;
  margin-bottom: 14rpx;
  border-bottom: 1rpx dashed rgba(37, 28, 56, 0.05);
}
.frow:last-child {
  border-bottom: none;
  padding-bottom: 0;
  margin-bottom: 0;
}
.ftag {
  flex: 0 0 56rpx;
  height: 92rpx; /* 与一格等高:整层换行时楼层号仍贴着第一排 */
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 21rpx;
  font-weight: 700;
  color: #c2b9cf;
  font-variant-numeric: tabular-nums;
}
/*
 * 定列数(2~4 列,见 home.js 的 withColumns)。
 * 一层两户 → 两个大格;门市一层 11 户 → 4 列换行,房号仍然读得清。
 */
.cells {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cell {
  flex: 0 0 auto;
  min-height: 92rpx;
  padding: 18rpx 6rpx 14rpx;
  border-radius: 16rpx;
  background: linear-gradient(180deg, #ffffff, #f6f1e9);
  border: 1rpx solid rgba(59, 43, 87, 0.1);
  box-shadow: 0 3rpx 10rpx rgba(70, 52, 29, 0.05), inset 0 1rpx 0 #ffffff;
  text-align: center;
  box-sizing: border-box;
}
.cols-2 .cell { width: calc((100% - 12rpx) / 2); }
.cols-3 .cell { width: calc((100% - 24rpx) / 3); }
.cols-4 .cell { width: calc((100% - 36rpx) / 4); }
.cell-hover { transform: scale(0.97); }
.cno {
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--text, #251c38);
  font-variant-numeric: tabular-nums;
  /* 「107门市」这种带字的号宁可折行也不截断:房号截一半就指错了房 */
  word-break: break-all;
}
.cols-3 .cno { font-size: 28rpx; }
.cols-4 .cno { font-size: 26rpx; }
.camt {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--danger, #c45656);
  font-variant-numeric: tabular-nums;
}
.cell-unpaid {
  background: linear-gradient(180deg, #fdf1ef, #f8e2df);
  border-color: rgba(196, 86, 86, 0.38);
  box-shadow: 0 3rpx 10rpx rgba(196, 86, 86, 0.12), inset 0 1rpx 0 #fff7f6;
}
.cell-unpaid .cno { color: #b23f3f; }
/* 停用 = 这格没在收:虚线空框,而不是把一块实心格调透明 */
.cell-off {
  background: transparent;
  border: 1rpx dashed rgba(37, 28, 56, 0.22);
  box-shadow: none;
}
.cell-off .cno { color: #b6aec2; font-weight: 700; }

/* 欠费条:金额在左、动作在右,整条可点 */
.ar-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(196, 86, 86, 0.12), rgba(253, 251, 247, 0.94));
  border: 2rpx solid rgba(196, 86, 86, 0.22);
}
.ar-main { flex: 1; min-width: 0; }
.ar-num {
  font-size: 38rpx;
  font-weight: 900;
  color: #b23f3f;
}
.ar-lab {
  margin-top: 2rpx;
  font-size: 23rpx;
  color: var(--text-3, #7c7288);
}
.ar-go {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: #b23f3f;
}

