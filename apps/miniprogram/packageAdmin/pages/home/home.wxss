@import "../../adm.wxss";

/* ── 待办条 ── */
.todo-strip {
  white-space: nowrap;
  margin-bottom: 4rpx;
}
.todo-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-right: 14rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, var(--note, #fff1c8), rgba(201, 166, 107, 0.35));
  border: 1rpx solid rgba(201, 166, 107, 0.4);
}
.todo-count {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: var(--danger, #c45656);
  color: #fff;
  font-size: 23rpx;
  font-weight: 800;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}
.todo-label {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--text, #251c38);
}

/* ── 楼栋条 ── */
.b-strip {
  margin-top: 22rpx;
  white-space: nowrap;
}
.b-chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 16rpx 26rpx;
  border-radius: 24rpx;
  background: rgba(253, 251, 247, 0.9);
  border: 2rpx solid rgba(37, 28, 56, 0.07);
  box-shadow: 0 8rpx 24rpx rgba(70, 52, 29, 0.06);
}
.b-chip-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
}
.b-chip-on .b-chip-name { color: var(--cream-2, #fdfbf7); }
.b-chip-on .b-chip-warn,
.b-chip-on .b-chip-ok { color: rgba(253, 251, 247, 0.72); }
.b-chip-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.b-chip-sub { margin-top: 2rpx; font-size: 21rpx; }
.b-chip-warn { color: var(--danger, #c45656); font-weight: 700; }
.b-chip-ok { color: var(--text-4, #8b8199); }

/* ── 单元卡 + 楼层格 ── */
.unit-card {
  margin-top: 24rpx;
  border-radius: 32rpx;
  background: rgba(253, 251, 247, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 20rpx 50rpx rgba(70, 52, 29, 0.08);
  padding: 26rpx 24rpx;
}
.unit-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}
.unit-name {
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.unit-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--text-4, #8b8199);
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 5rpx;
  background: rgba(90, 70, 128, 0.16);
}
.dot-r { background: #e0908f; }
.dot-g { background: rgba(37, 28, 56, 0.14); }

.frow {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 14rpx;
}
.ftag {
  flex: 0 0 56rpx;
  height: 92rpx; /* 与一格等高:整层换行时楼层号仍贴着第一排 */
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 22rpx;
  font-weight: 700;
  color: #b0a8bd;
  font-variant-numeric: tabular-nums;
}
/*
 * 定列数(2~4 列,见 home.js 的 withColumns)。
 * 一层两户 → 两个大格;门市一层 11 户 → 4 列换行,房号仍然读得清。
 */
.cells {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.cell {
  flex: 0 0 auto;
  min-height: 92rpx;
  padding: 18rpx 6rpx 14rpx;
  border-radius: 18rpx;
  background: rgba(90, 70, 128, 0.06);
  border: 2rpx solid rgba(90, 70, 128, 0.08);
  text-align: center;
  box-sizing: border-box;
}
.cols-2 .cell { width: calc((100% - 12rpx) / 2); }
.cols-3 .cell { width: calc((100% - 24rpx) / 3); }
.cols-4 .cell { width: calc((100% - 36rpx) / 4); }
.cell-hover { transform: scale(0.97); }
.cno {
  font-size: 30rpx;
  line-height: 1.25;
  font-weight: 800;
  color: var(--text, #251c38);
  font-variant-numeric: tabular-nums;
  /* 「107门市」这种带字的号宁可折行也不截断:房号截一半就指错了房 */
  word-break: break-all;
}
.cols-3 .cno { font-size: 28rpx; }
.cols-4 .cno { font-size: 26rpx; }
.camt {
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--danger, #c45656);
  font-variant-numeric: tabular-nums;
}
.cell-unpaid {
  background: rgba(196, 86, 86, 0.09);
  border-color: rgba(196, 86, 86, 0.32);
}
.cell-unpaid .cno { color: #b23f3f; }
.cell-off { opacity: 0.35; }

/* 底部快捷动作 */
.quick {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.quick-btn { flex: 1; }

/* 欠费条:金额在左、动作在右,整条可点 */
.ar-bar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, rgba(196, 86, 86, 0.12), rgba(253, 251, 247, 0.94));
  border: 2rpx solid rgba(196, 86, 86, 0.22);
}
.ar-main { flex: 1; min-width: 0; }
.ar-num {
  font-size: 38rpx;
  font-weight: 900;
  color: #b23f3f;
}
.ar-lab {
  margin-top: 2rpx;
  font-size: 23rpx;
  color: var(--text-3, #7c7288);
}
.ar-go {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 800;
  color: #b23f3f;
}

/* 新增房屋:虚线,和楼盘图排在一起 */
.add-house {
  margin-top: 18rpx;
  height: 92rpx;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(184, 134, 47, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--gold-deep, #b8862f);
}

.staff-entry { margin-top: 16rpx; }
