<view class="page adm-page">
  <block wx:if="{{denied}}">
    <view class="adm-denied">
      <view class="adm-denied-title">没有管理权限</view>
      <view class="adm-denied-desc">此入口仅限物业工作人员。若您是物业人员,请联系管理员把您的手机号登记为管理账号,然后重新授权手机号。</view>
    </view>
  </block>

  <block wx:else>
    <view class="adm-hello">物业管理 · {{adminName}}</view>

    <!-- 大搜索框:接电话查户是最高频动作,永远在最上面 -->
    <input
      class="adm-search"
      placeholder="输房号 / 业主姓名 / 手机号,直达那套房"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
    />

    <view wx:if="{{searching}}" class="adm-hint">搜索中…</view>
    <view wx:if="{{houses.length > 0}}" class="adm-card">
      <view class="adm-row" wx:for="{{houses}}" wx:key="id" data-id="{{item.id}}" bindtap="goHouse" hover-class="adm-row-hover">
        <view class="adm-row-main">
          <view class="adm-row-title">{{item.displayName}}</view>
          <view class="adm-row-sub">{{item.code}}<text wx:if="{{item.ownerName}}"> · {{item.ownerName}}</text></view>
        </view>
        <view class="adm-arrow">›</view>
      </view>
      <view wx:if="{{houseTotal > houses.length}}" class="adm-hint">共 {{houseTotal}} 套,只显示前 {{houses.length}},请输入更完整的房号</view>
    </view>
    <view wx:elif="{{keyword && !searching}}" class="adm-hint">没有找到,试试房号的其他写法(如 B-5-1602 / 2-1-1-701)</view>

    <!-- 待办卡:今天该干什么 -->
    <block wx:if="{{!keyword}}">
      <view class="adm-section">今日待办</view>
      <view wx:if="{{loading}}" class="adm-hint">加载中…</view>
      <view wx:elif="{{todos.length === 0}}" class="adm-hint">没有待办事项 ✓</view>
      <view class="adm-card" wx:if="{{todos.length > 0}}">
        <view class="adm-row" wx:for="{{todos}}" wx:key="key" data-url="{{item.url}}" bindtap="onTodoTap" hover-class="adm-row-hover">
          <view class="adm-row-main">
            <view class="adm-row-title">{{item.label}}</view>
            <view wx:if="{{!item.url}}" class="adm-row-sub">在电脑后台处理</view>
          </view>
          <view class="adm-badge">{{item.count}}</view>
        </view>
      </view>

      <block wx:if="{{arrears}}">
        <view class="adm-section">收缴一览</view>
        <view class="adm-card adm-stats">
          <view class="adm-stat">
            <view class="adm-stat-num">¥{{arrears.amount}}</view>
            <view class="adm-stat-label">欠费合计 · {{arrears.houses}} 户</view>
          </view>
          <view class="adm-stat">
            <view class="adm-stat-num adm-danger">¥{{arrears.overdueAmount}}</view>
            <view class="adm-stat-label">其中已逾期 · {{arrears.overdueHouses}} 户</view>
          </view>
        </view>
      </block>
    </block>
  </block>
</view>
