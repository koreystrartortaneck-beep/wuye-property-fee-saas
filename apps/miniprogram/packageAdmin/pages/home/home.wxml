<view class="page adm-page">
  <block wx:if="{{denied}}">
    <view class="adm-denied">
      <view class="adm-denied-title">没有管理权限</view>
      <view class="adm-denied-desc">此入口仅限物业工作人员。若您是物业人员,请联系管理员把您的手机号登记为管理账号,然后重新授权手机号。</view>
      <view class="adm-btn adm-retry" bindtap="onShow">重试</view>
    </view>
  </block>

  <block wx:else>
    <input
      class="adm-search"
      placeholder="搜房号 / 业主 / 手机号"
      value="{{keyword}}"
      confirm-type="search"
      bindinput="onKeywordInput"
    />

    <!-- 搜索态:结果列表替换楼盘图 -->
    <block wx:if="{{keyword}}">
      <view wx:if="{{searching}}" class="adm-hint">搜索中…</view>
      <view wx:elif="{{houses.length === 0}}" class="adm-hint">没有找到,试试房号其他写法(B-5-1602 / 2-1-1-701)</view>
      <view class="adm-card" wx:if="{{houses.length > 0}}">
        <view class="adm-row" wx:for="{{houses}}" wx:key="id" data-id="{{item.id}}" bindtap="goHouse" hover-class="adm-row-hover">
          <view class="adm-row-main">
            <view class="adm-row-title">{{item.displayName}}</view>
            <view class="adm-row-sub">{{item.code}}<text wx:if="{{item.ownerName}}"> · {{item.ownerName}}</text></view>
          </view>
          <view class="adm-arrow">›</view>
        </view>
        <view wx:if="{{houseTotal > houses.length}}" class="adm-hint">共 {{houseTotal}} 套,输入更完整的房号缩小范围</view>
      </view>
    </block>

    <block wx:else>
      <!-- 待办条:紧凑横排,有事才出现 -->
      <scroll-view wx:if="{{todos.length > 0}}" scroll-x class="todo-strip" enhanced show-scrollbar="{{false}}">
        <view class="todo-chip" wx:for="{{todos}}" wx:key="key" data-url="{{item.url}}" bindtap="onTodoTap">
          <text class="todo-count">{{item.count}}</text>
          <text class="todo-label">{{item.label}}</text>
        </view>
      </scroll-view>

      <!-- 欠费:不是「待处理单据」而是常态,所以单独一条,点进去催缴 -->
      <view wx:if="{{arrears}}" class="ar-bar" bindtap="goDun">
        <view class="ar-main">
          <view class="ar-num adm-num">¥{{arrears.amount}}</view>
          <view class="ar-lab">{{arrears.houses}} 户欠费<text wx:if="{{arrears.overdueHouses > 0}}"> · {{arrears.overdueHouses}} 户已逾期</text></view>
        </view>
        <view class="ar-go">去催缴 ›</view>
      </view>

      <!-- 楼栋条 -->
      <view wx:if="{{loading}}" class="adm-hint">加载楼盘图…</view>
      <view wx:if="{{gridError}}" class="adm-hint adm-error" bindtap="retryGrid">{{gridError}}</view>
      <scroll-view wx:if="{{buildings.length > 0}}" scroll-x class="b-strip" enhanced show-scrollbar="{{false}}">
        <view
          class="b-chip {{picked === item.building ? 'b-chip-on' : ''}}"
          wx:for="{{buildings}}"
          wx:key="building"
          data-b="{{item.building}}"
          bindtap="pickBuilding"
        >
          <view class="b-chip-name">{{item.building}}</view>
          <view class="b-chip-sub">
            <text wx:if="{{item.unpaidHouses > 0}}" class="b-chip-warn">欠 {{item.unpaidHouses}} 户</text>
            <text wx:else class="b-chip-ok">无欠费</text>
          </view>
        </view>
      </scroll-view>

      <!-- 楼盘图:一层一行,列数固定(每层同一列 = 同一位置),顶层在上 -->
      <view class="unit-card" wx:for="{{units}}" wx:key="unit" wx:for-item="u">
        <view class="unit-head">
          <view class="unit-name">{{picked}}<text wx:if="{{u.unit}}"> · {{u.unit}}</text></view>
          <view class="unit-legend">
            <view class="dot"></view>正常
            <view class="dot dot-r"></view>待缴
            <view class="dot dot-g"></view>停用
          </view>
        </view>
        <view class="frow" wx:for="{{u.floors}}" wx:key="floor" wx:for-item="f">
          <view class="ftag">{{f.floor > 0 ? f.floor : ''}}</view>
          <view class="cells cols-{{u.cols}}">
            <view
              class="cell {{item.unpaidCount > 0 ? 'cell-unpaid' : ''}} {{item.disabled ? 'cell-off' : ''}}"
              wx:for="{{f.cells}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="goHouse"
              hover-class="cell-hover"
            >
              <view class="cno">{{item.label}}</view>
              <view wx:if="{{item.unpaidCount > 0}}" class="camt">¥{{item.unpaidAmount}}</view>
            </view>
          </view>
        </view>
      </view>
      <view wx:if="{{units.length > 0}}" class="adm-hint">点房间 = 进这一户:改面积/放户日期、换住户手机号、只给这一户发账单</view>

      <!-- 批量动作:一屏一个主动作(发账单),其余用素色 -->
      <view class="quick" wx:if="{{buildings.length > 0}}">
        <view class="adm-btn adm-btn-ghost quick-btn" bindtap="goAnnounce">发公告</view>
        <view class="adm-btn quick-btn" bindtap="goBilling">发账单</view>
      </view>
      <view class="quick" wx:if="{{buildings.length > 0}}">
        <view class="adm-btn adm-btn-ghost quick-btn" bindtap="goTickets">报事报修</view>
        <view class="adm-btn adm-btn-ghost quick-btn" bindtap="goDun">欠费催缴</view>
      </view>
    </block>
  </block>
</view>
