<view class="page adm-page workspace">
  <view wx:if="{{denied}}" class="adm-denied"><view class="adm-denied-title">没有管理权限</view><view class="adm-denied-desc">请联系物业管理员开通账号</view><view class="adm-btn adm-retry" bindtap="onShow">重试</view></view>
  <block wx:else>
    <view class="workspace-head">
      <view class="tabs">
        <view class="tab {{tab === 'grid' ? 'tab-on' : ''}}" data-t="grid" bindtap="pickTab">楼盘图</view>
        <view class="tab {{tab === 'arrears' ? 'tab-on' : ''}}" data-t="arrears" bindtap="pickTab">欠费<text wx:if="{{arrears.houses}}" class="tab-bd">{{arrears.houses}}</text></view>
        <view class="tab {{tab === 'tickets' ? 'tab-on' : ''}}" data-t="tickets" bindtap="pickTab">报修<text wx:if="{{ticketCount}}" class="tab-bd">{{ticketCount}}</text></view>
        <view class="tab {{tab === 'batches' ? 'tab-on' : ''}}" data-t="batches" bindtap="pickTab">待发布<text wx:if="{{draftCount}}" class="tab-bd">{{draftCount}}</text></view>
        <view class="tab {{tab === 'tools' ? 'tab-on' : ''}}" data-t="tools" bindtap="pickTab">功能</view>
      </view>
      <block wx:if="{{tab === 'grid'}}">
        <input class="adm-search" placeholder="搜索房号 / 业主 / 手机号" value="{{keyword}}" confirm-type="search" bindinput="onKeywordInput" />
        <view wx:if="{{!keyword}}" class="adm-filters">
          <view bindtap="openBuildings">{{picked || '选择楼栋'}} ▾</view>
          <picker wx:if="{{!isFlat}}" range="{{unitOptions}}" value="{{unitIndex}}" bindchange="pickUnit"><view>{{unitOptions[unitIndex]}} ▾</view></picker>
          <picker wx:if="{{!isFlat}}" range="{{floorOptions}}" value="{{floorIndex}}" bindchange="jumpFloor"><view>楼层 ▾</view></picker>
        </view>
        <view wx:if="{{!keyword && isFlat}}" class="adm-pager"><view data-delta="-1" bindtap="turnFlat">上一页</view><text>{{flatPage}} / {{flatPages}}</text><view data-delta="1" bindtap="turnFlat">下一页</view></view>
      </block>
    </view>
    <view hidden="{{tab !== 'grid'}}">
      <block wx:if="{{keyword}}">
        <view wx:if="{{searching}}" class="adm-hint">搜索中…</view>
        <view wx:elif="{{houses.length === 0}}" class="adm-empty">未找到房屋</view>
        <view class="adm-card" wx:if="{{houses.length}}">
          <view class="adm-row" wx:for="{{houses}}" wx:key="id" data-id="{{item.id}}" bindtap="goHouse"><view class="adm-row-main"><view class="adm-row-title">{{item.displayName || item.code}}</view><view class="adm-row-sub">{{item.code}} {{item.ownerName}}</view></view><text>›</text></view>
        </view>
        <view wx:if="{{houseTotal > houses.length}}" class="adm-hint">共 {{houseTotal}} 户，请输入完整房号查询</view>
      </block>
      <block wx:else>
        <view wx:if="{{loading}}" class="adm-hint">加载中…</view>
        <view wx:if="{{gridError}}" class="adm-hint adm-error" bindtap="retryGrid">{{gridError}}</view>
        <view class="grid-legend">橙色：待缴　绿色：无欠费　灰色：停用</view>
        <view wx:if="{{isFlat}}" class="adm-card">
          <view class="adm-row" wx:for="{{flatRows}}" wx:key="id" data-id="{{item.id}}" bindtap="goHouse"><view class="adm-row-main adm-row-title">{{item.displayName || item.label}}</view><text class="{{item.unpaidCount ? 'adm-danger' : ''}}">{{item.unpaidCount ? '¥'+item.unpaidAmount : item.disabled ? '停用' : '无欠费'}} ›</text></view>
        </view>
        <block wx:else><block wx:for="{{units}}" wx:key="unit" wx:for-item="u">
          <view class="frow" wx:for="{{u.floors}}" wx:key="floor" wx:for-item="f" wx:for-index="fi" id="floor-{{fi}}">
            <view class="ftag">{{f.floor}}F</view><view class="cells cols-{{u.cols}}">
              <view class="cell {{item.unpaidCount > 0 ? 'cell-unpaid' : ''}} {{item.disabled ? 'cell-off' : ''}}" wx:for="{{f.cells}}" wx:key="id" data-id="{{item.id}}" bindtap="goHouse"><view class="cno">{{item.label}}</view><view class="camt">{{item.unpaidCount ? '¥'+item.unpaidAmount : item.disabled ? '停用' : '无欠费'}}</view></view>
            </view>
          </view>
        </block></block>
      </block>
    </view>
    <view hidden="{{tab !== 'arrears'}}" style="--panel-top:96rpx"><arrears-panel wx:if="{{mounted.arrears}}" id="arrears" active="{{tab === 'arrears'}}" /></view>
    <view hidden="{{tab !== 'tickets'}}" style="--panel-top:96rpx"><ticket-panel wx:if="{{mounted.tickets}}" id="tickets" active="{{tab === 'tickets'}}" /></view>
    <view hidden="{{tab !== 'batches'}}" style="--panel-top:96rpx"><batch-panel wx:if="{{mounted.batches}}" id="batches" active="{{tab === 'batches'}}" /></view>
    <view wx:if="{{tab === 'tools'}}" class="tools">
      <view class="tool tool-main" bindtap="goBilling"><view class="tool-name">发账单</view><view class="tool-desc">生成账单</view></view>
      <view class="tool tool-receipts" bindtap="goReceipts"><view class="tool-name">收款收据</view><view class="tool-desc">查询缴费记录与电子收据</view></view>
      <view class="tool" bindtap="goNewHouse"><view class="tool-name">新增房屋</view></view>
      <view class="tool" bindtap="goApprovals"><view class="tool-name">绑定审批<text wx:if="{{bindingCount}}" class="tab-bd">{{bindingCount}}</text></view></view>
      <view class="tool" bindtap="goCouponVerify"><view class="tool-name">核销卡券</view></view>
      <view class="tool" bindtap="goAnnounce"><view class="tool-name">发公告</view></view>
      <view wx:if="{{isAdmin}}" class="tool" bindtap="goCouponNew"><view class="tool-name">发卡券</view></view>
      <view wx:if="{{isAdmin}}" class="tool" bindtap="goStaff"><view class="tool-name">员工与权限</view></view>
    </view>
    <view wx:if="{{buildingOpen}}" class="adm-mask"><view class="adm-sheet"><view class="adm-sheet-title">选择楼栋<text bindtap="closeBuildings">关闭</text></view><input class="adm-search" placeholder="搜索楼栋" value="{{buildingQuery}}" bindinput="filterBuildings"/><scroll-view scroll-y style="max-height:55vh"><view class="adm-row" wx:for="{{buildingOptions}}" wx:key="building" data-b="{{item.building}}" bindtap="chooseBuilding"><view class="adm-row-main">{{item.building}}</view><text>{{item.houses}} 户 ›</text></view></scroll-view></view></view>
  </block>
</view>
