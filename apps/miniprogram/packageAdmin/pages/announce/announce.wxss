@import "../../adm.wxss";

.write { padding: 26rpx; }
.an-title {
  width: 100%;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--text, #251c38);
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.07);
}
.an-body {
  width: 100%;
  height: 320rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text, #251c38);
  box-sizing: border-box;
}
.an-opts {
  display: flex;
  gap: 40rpx;
  margin-top: 18rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(37, 28, 56, 0.07);
}
.an-opt {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text-2, #55496b);
}
.tick {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(37, 28, 56, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  color: transparent;
}
.tick-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
  color: var(--cream-2, #fdfbf7);
}
.send-btn { margin-top: 30rpx; }
