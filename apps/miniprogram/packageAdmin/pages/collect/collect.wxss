@import "../../adm.wxss";

/* 金额卡:一屏最重要的数字,且不可编辑 */
.sum-card {
  border-radius: 34rpx;
  padding: 34rpx 32rpx;
  background: linear-gradient(135deg, var(--plum, #3b2b57), var(--text, #251c38) 70%);
  box-shadow: 0 24rpx 60rpx rgba(37, 28, 56, 0.26);
}
.sum-num {
  font-size: 62rpx;
  line-height: 1.1;
  font-weight: 900;
  color: var(--cream-2, #fdfbf7);
}
.sum-lab {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: rgba(253, 251, 247, 0.62);
}

/* 收款方式:四格,选中深紫 */
.m-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.m-i {
  flex: 0 0 calc((100% - 14rpx) / 2);
  height: 92rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  background: rgba(253, 251, 247, 0.9);
  border: 2rpx solid rgba(37, 28, 56, 0.07);
  color: var(--text, #251c38);
  box-sizing: border-box;
}
.m-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
  color: var(--cream-2, #fdfbf7);
}

/* 表单行 */
.f-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 104rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.05);
}
.f-row:last-child { border-bottom: none; }
.f-lab {
  flex: 0 0 140rpx;
  font-size: 27rpx;
  color: var(--text-2, #55496b);
}
.f-in { flex: 1; min-width: 0; }
.pick-line {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: var(--text, #251c38);
}

/* 收完 */
.done {
  margin-top: 40rpx;
  text-align: center;
  padding: 50rpx 30rpx;
  border-radius: 34rpx;
  background: rgba(253, 251, 247, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 20rpx 50rpx rgba(70, 52, 29, 0.08);
}
.done-tick {
  width: 108rpx;
  height: 108rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #7fae72, #4f7d44);
  color: #fff;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 108rpx;
}
.done-num {
  font-size: 50rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.done-lab {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: var(--text-3, #7c7288);
  font-variant-numeric: tabular-nums;
}

.act { margin-top: 34rpx; }
