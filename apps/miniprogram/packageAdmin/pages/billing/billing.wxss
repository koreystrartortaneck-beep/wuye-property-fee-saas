@import "../../adm.wxss";

.pick-line {
  display: flex;
  align-items: center;
  font-weight: 700;
  color: var(--text, #251c38);
}
.full { width: 100%; margin-top: 8rpx; }

.scope-row {
  display: flex;
  gap: 14rpx;
}
.scope {
  flex: 1;
  height: 92rpx;
  border-radius: 22rpx;
  background: rgba(253, 251, 247, 0.9);
  border: 2rpx solid rgba(37, 28, 56, 0.07);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}
.scope-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
  color: var(--cream-2, #fdfbf7);
}

.b-strip { white-space: nowrap; margin-top: 8rpx; }
.b-chip {
  display: inline-block;
  margin-right: 14rpx;
  padding: 16rpx 26rpx;
  border-radius: 22rpx;
  background: rgba(253, 251, 247, 0.9);
  border: 2rpx solid rgba(37, 28, 56, 0.07);
}
.b-chip-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
}
.b-chip-on .b-chip-name { color: var(--cream-2, #fdfbf7); }
.b-chip-on .b-chip-ok { color: rgba(253, 251, 247, 0.72); }
.b-chip-name { font-size: 29rpx; font-weight: 900; color: var(--text, #251c38); }
.b-chip-sub { margin-top: 2rpx; font-size: 21rpx; }
.b-chip-ok { color: var(--text-4, #8b8199); }

/* 汇总卡:一屏最重要的那个数字 */
.sum-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-radius: 32rpx;
  padding: 32rpx 30rpx;
  background: linear-gradient(135deg, var(--plum, #3b2b57), var(--text, #251c38) 70%);
  box-shadow: 0 24rpx 60rpx rgba(37, 28, 56, 0.26);
}
.sum-main { flex: 1; min-width: 0; }
.sum-num {
  font-size: 46rpx;
  font-weight: 900;
  color: var(--cream-2, #fdfbf7);
}
.sum-lab {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: rgba(253, 251, 247, 0.6);
}
.sum-ex {
  flex-shrink: 0;
  text-align: right;
  font-size: 22rpx;
  line-height: 1.5;
  color: #f0b9b8;
  font-weight: 700;
}
/* 被点掉的行:除了变灰,还要有字说明 —— 只靠透明度,人会以为是加载中 */
.tag-ex {
  margin-left: 10rpx;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(196, 86, 86, 0.12);
  color: var(--danger, #c45656);
  font-size: 20rpx;
  font-weight: 700;
}

/* 勾选 */
.tick {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(37, 28, 56, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: transparent;
}
.tick-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
  color: var(--cream-2, #fdfbf7);
}
.row-ex { opacity: 0.42; }

.step-btn { margin-top: 34rpx; }
.pub-btn { margin-top: 34rpx; }
.two-btn { display: flex; gap: 16rpx; margin-top: 34rpx; }
.half { flex: 1; }
