@import "../../adm.wxss";

.sum-card {
  border-radius: 34rpx;
  padding: 32rpx;
  background: linear-gradient(135deg, var(--plum, #3b2b57), var(--text, #251c38) 70%);
  box-shadow: 0 24rpx 60rpx rgba(37, 28, 56, 0.26);
}
.sum-num {
  font-size: 56rpx;
  line-height: 1.1;
  font-weight: 900;
  color: var(--cream-2, #fdfbf7);
}
.sum-lab {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(253, 251, 247, 0.62);
}

/* 过滤条 */
.f-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 24rpx;
}
.f-chip {
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 700;
  background: rgba(253, 251, 247, 0.9);
  border: 2rpx solid rgba(37, 28, 56, 0.07);
  color: var(--text-2, #55496b);
}
.f-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
  color: var(--cream-2, #fdfbf7);
}
.f-sort { color: var(--gold-deep, #b8862f); }

.sec-act {
  float: right;
  padding: 0 8rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: var(--gold-deep, #b8862f);
}

/* 勾选:选中才是深紫实心 */
.tick {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(37, 28, 56, 0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: transparent;
}
.tick-on {
  background: linear-gradient(145deg, var(--plum, #3b2b57), var(--text, #251c38));
  border-color: transparent;
  color: var(--cream-2, #fdfbf7);
}

.own {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: var(--text-3, #7c7288);
}
.r-right { flex-shrink: 0; text-align: right; }
.r-call { display: inline-flex; margin-top: 8rpx; }

.act { margin-top: 30rpx; }

/* ── 选中即浮出的底部操作条 ── */
.dun-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 28rpx;
  /* 全面屏底部留出安全区 */
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(253, 251, 247, 0.97);
  border-top: 1rpx solid rgba(59, 43, 87, 0.12);
  box-shadow: 0 -10rpx 30rpx rgba(37, 28, 56, 0.1);
}
.dun-bar-info {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.dun-bar-n {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}
.dun-bar-clear {
  font-size: 24rpx;
  color: var(--text-4, #8b8199);
  text-decoration: underline;
}
.dun-bar-btn {
  flex: 0 0 auto;
  padding: 0 56rpx;
}
.dun-bar-pad { height: 140rpx; }
