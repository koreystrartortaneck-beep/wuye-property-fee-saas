  <view wx:if="{{loading}}" class="adm-hint">加载中…</view>
  <view wx:elif="{{loadError}}" class="adm-denied">
    <view class="adm-denied-title">加载失败</view>
    <view class="adm-denied-desc">请检查网络后重试</view>
    <view class="adm-btn adm-retry" bindtap="load">重试</view>
  </view>

  <block wx:else>
    <view class="sum-card">
      <view class="sum-num adm-num">¥{{total}}</view>
      <view class="sum-lab">{{totalHouses}} 户欠费<text wx:if="{{overdueHouses > 0}}"> · 其中 {{overdueHouses}} 户已逾期</text></view>
    </view>

    <view class="adm-sticky"><input class="adm-search" placeholder="搜索房号 / 业主 / 手机号" value="{{keyword}}" bindinput="onSearch" />
    <view class="f-strip">
      <view
        class="f-chip {{overdueDays === item.key ? 'f-on' : ''}}"
        wx:for="{{filters}}"
        wx:key="key"
        data-k="{{item.key}}"
        bindtap="pickFilter"
      >{{item.label}}</view>
      <view class="f-chip f-sort" bindtap="toggleSort">{{sort === 'days' ? '逾期优先' : '金额优先'}} ⇅</view>
    </view>

    <view class="adm-pager"><view data-delta="-1" bindtap="turn">上一页</view><text>{{page}} / {{pages}}</text><view data-delta="1" bindtap="turn">下一页</view></view></view>
    <view wx:if="{{rows.length === 0}}" class="adm-denied">
      <view class="adm-denied-title">没有欠费</view>
      <view class="adm-denied-desc">当前筛选范围内无欠费。</view>
    </view>

    <block wx:else>
      <view class="adm-sec">
        欠费清单
        <text class="sec-act" bindtap="toggleAll">{{allPicked ? '取消全选' : '全选'}}</text>
      </view>
      <view class="adm-card">
        <view class="adm-row" wx:for="{{visibleRows}}" wx:key="houseId">
          <!-- checked 由 JS 预先算好:WXML 不支持函数调用,indexOf 在这里永远求不出值 -->
          <view class="tick {{item.checked ? 'tick-on' : ''}}" data-id="{{item.houseId}}" bindtap="toggleRow">
            {{item.checked ? '✓' : ''}}
          </view>
          <view class="adm-row-main" data-id="{{item.houseId}}" bindtap="goHouse">
            <view class="adm-row-title">{{item.name}}<text wx:if="{{item.ownerName}}" class="own"> {{item.ownerName}}</text></view>
            <view class="adm-row-sub">
              欠 {{item.unpaidCount}} 笔
              <text wx:if="{{item.overdueDays > 0}}" class="adm-danger"> · 逾期 {{item.overdueDays}} 天</text>
              <text wx:else> · 未到期</text>
            </view>
          </view>
          <view class="r-right">
            <view class="adm-row-title adm-num">¥{{item.unpaidAmount}}</view>
            <view wx:if="{{item.phone}}" class="adm-pill adm-pill-quiet r-call" data-phone="{{item.phone}}" bindtap="call">打电话</view>
          </view>
        </view>
      </view>
      <view wx:if="{{truncated}}" class="adm-hint adm-error">共 {{truncated}} 户欠费,这里只列出前 {{rows.length}} 户;要全量请在电脑后台导出。</view>


      <!-- 全选与发送常驻底部，覆盖筛选后的全部页。 -->
      <view class="dun-bar" hidden="{{!active}}">
        <view class="dun-bar-info">
          <view class="dun-bar-n">已选 {{picked.length}} 户</view>
          <view class="dun-bar-clear" bindtap="clearPicked">清空</view>
        </view>
        <view class="dun-controls"><view class="adm-btn adm-btn-ghost" bindtap="toggleAll">{{allPicked ? '取消全选' : '全部勾选'}}</view>
        <view class="adm-btn dun-bar-btn {{dunning ? 'adm-btn-busy' : ''}}" bindtap="dun">{{dunning ? '提交中…' : '发送提醒'}}</view></view>
      </view>
      <!-- 操作条浮着时给列表底部留出高度,最后一行不被盖住 -->
      <view class="dun-bar-pad"></view>
    </block>
  </block>
