<view wx:if="{{loading}}" class="adm-hint">加载中…</view>
<view wx:elif="{{loadError}}" class="adm-hint adm-error" bindtap="load">加载失败，点击重试</view>
<block wx:else>
  <view class="adm-sticky"><view class="adm-summary">待发布 {{batches.length}} 批</view><view class="adm-pager"><view data-delta="-1" bindtap="turn">上一页</view><text>{{page}} / {{pages}}</text><view data-delta="1" bindtap="turn">下一页</view></view></view>
  <view wx:if="{{!batches.length}}" class="adm-empty">暂无待发布账单</view>
  <view class="bt-card" wx:for="{{visibleBatches}}" wx:key="id" wx:for-item="b">
    <view class="bt-title">{{b.title}}</view><view class="bt-sub">{{b.count}} 笔待发布</view>
    <view class="adm-btn adm-btn-ghost" data-id="{{b.id}}" bindtap="open">核对账单</view>
    <view class="adm-link" data-i="{{(page - 1) * 20 + index}}" bindtap="cancelBatch">作废草稿</view>
  </view>
</block>
