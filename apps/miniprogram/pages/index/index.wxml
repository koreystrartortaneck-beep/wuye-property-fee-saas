<view class="page has-navbar">
  <view style="height: {{nav.spacerPx}}px"></view>
  <view class="nav-row" style="height: {{nav.rowPx}}px">
    <view class="nav-row-title">{{currentHouse ? currentHouse.communityName : '物业缴费'}}</view>
  </view>
  <view class="nav-sub-row">雅致生活 · 从容缴费</view>

  <!-- 首屏加载态 -->
  <view wx:if="{{!ready}}" class="hero-card">
    <view class="hero-kicker">PROPERTY SERVICE</view>
    <view class="hero-title">加载中…</view>
    <view class="amount-panel">
      <view class="panel-label">正在获取您的房屋与账单</view>
    </view>
  </view>

  <!--
    未绑定房屋的三种情形，必须分开。
    myHouses 只返回 ACTIVE 绑定，所以「从没申请过」「审核中」「被驳回」
    原本落到同一个分支，首页一律说「首次使用请先绑定您的房屋」——
    对已经申请过的人说这句话，他会以为申请丢了，然后再申请一次。
  -->
  <view wx:if="{{ready && noHouse}}" class="hero-card">
    <view class="hero-kicker">PROPERTY SERVICE</view>

    <!-- ① 审核中：不给「立即绑定」，避免他重复申请撞唯一约束 -->
    <block wx:if="{{pendingBinding && !pendingBinding.rejected}}">
      <view class="hero-title">{{'绑定申请\n审核中'}}</view>
      <view class="amount-panel">
        <view class="panel-label">{{pendingBinding.house}}</view>
        <view class="pending-note">物业审核通过后，这里会显示您的待缴账单。可在「我的」查看进度。</view>
      </view>
    </block>

    <!--
      ② 被驳回 / 被解除：都要说明原因，并允许重新申请。
      两者库里都是 REJECTED，但对业主是完全不同的事 ——
      「申请未通过」是你还没进来，「绑定已解除」是你本来在、被请出去了。
      对一个原本能看到账单的人说「申请未通过」，他会一头雾水。
    -->
    <block wx:elif="{{pendingBinding && pendingBinding.rejected}}">
      <view class="hero-title">{{pendingBinding.revoked ? '房屋绑定\n已解除' : '绑定申请\n未通过'}}</view>
      <view class="amount-panel">
        <view class="panel-label">{{pendingBinding.house}}</view>
        <view class="pending-note">{{pendingBinding.reason || (pendingBinding.revoked ? '物业已解除该房屋的绑定，如有疑问请联系物业' : '物业未说明原因，可联系物业后重新申请')}}</view>
        <view class="amount-row">
          <view class="hero-amount amount"> </view>
          <button class="gold-button pay-btn" bindtap="goBind">重新申请</button>
        </view>
      </view>
    </block>

    <!-- ③ 从没申请过 -->
    <block wx:else>
      <view class="hero-title">{{'绑定房屋\n开启从容缴费'}}</view>
      <view class="amount-panel">
        <view class="panel-label">首次使用请先绑定您的房屋</view>
        <view class="amount-row">
          <view class="hero-amount amount"> </view>
          <button class="gold-button pay-btn" bindtap="goBind">立即绑定</button>
        </view>
      </view>
    </block>
  </view>

  <!-- 正常态 -->
  <!--
    加载失败：给出明确的失败提示与重试入口。绝不能落回「¥ 0.00 / 立即缴纳」——
    那会让业主以为自己没有欠费。
  -->
  <view wx:if="{{ready && !noHouse && error}}" class="state">
    <view class="state-icon">⚠️</view>
    <view class="state-text">没能加载账单信息，请检查网络</view>
    <button class="state-retry" bindtap="retry">点击重试</button>
  </view>

  <block wx:if="{{ready && !noHouse && !error}}">
    <!-- ① 缴费中心：账单的唯一入口 -->
    <view class="hero-card">
      <view class="hero-kicker">PROPERTY SERVICE</view>
      <view class="hero-title">{{paidUp ? '本期缴清\n生活从容' : '优雅缴费\n从容生活'}}</view>
      <view class="house-chip" bindtap="switchHouse">
        <view class="chip-dot"></view>
        <text>{{currentHouse.displayName}}{{houses.length > 1 ? ' ⇄' : ''}}</text>
      </view>
      <view class="amount-panel">
        <view class="panel-label">{{paidUp ? '本期费用已全部缴清，下期账单将自动提醒' : '待缴合计（' + unpaidCount + ' 笔）'}}</view>
        <view class="amount-row">
          <view wx:if="{{!paidUp}}" class="hero-amount amount">¥ {{unpaidTotal}}</view>
          <view wx:else class="paid-badge">
            <view class="pb-check">✓</view>
            <text>已缴清</text>
          </view>
          <button class="gold-button pay-btn" bindtap="heroAction">{{paidUp ? '查看账单' : '立即缴纳'}}</button>
        </view>
        <view wx:if="{{collectionPaused}}" class="pause-hint">物业已暂停线上收款{{pausedReason ? '：' + pausedReason : ''}}，如需缴费请联系物业</view>
      </view>
    </view>

    <!-- ② 社区动态：公告 + 物业公示 混排一条流（首页只放最近 3 条摘要） -->
    <view class="section-head">
      <view class="section-title">社区动态</view>
      <view class="section-more" bindtap="goFeed">查看全部</view>
    </view>

    <view class="home-ann-list">
      <block wx:for="{{feed}}" wx:key="id">
        <!-- 物业公示：带图卡片 -->
        <view wx:if="{{item.type === 'work'}}" class="feed-work card" data-id="{{item.id}}" data-type="work" bindtap="goFeedItem">
          <image class="fw-cover" src="{{item.cover}}" mode="aspectFill" />
          <view class="fw-body">
            <view class="ha-title-row">
              <text class="fw-tag">{{item.tag}}</text>
              <text class="ha-title">{{item.title}}</text>
              <text class="ha-date">{{item.date}}</text>
            </view>
            <view class="ha-preview" wx:if="{{item.preview}}">{{item.preview}}</view>
            <view class="fw-count" wx:if="{{item.count > 1}}">共 {{item.count}} 张实拍</view>
          </view>
        </view>
        <!-- 公告：纯文字卡片 -->
        <view wx:else class="home-ann-item card" data-id="{{item.id}}" data-type="ann" bindtap="goFeedItem">
          <view class="ha-title-row">
            <text wx:if="{{item.pinned}}" class="ha-pin">置顶</text>
            <text class="ha-title">{{item.title}}</text>
            <text class="ha-date">{{item.date}}</text>
          </view>
          <view class="ha-preview">{{item.preview}}</view>
        </view>
      </block>
      <view wx:if="{{feed.length === 0}}" class="home-ann-item card ha-empty">
        <view class="ha-title-row"><text class="ha-title">暂无社区动态</text></view>
        <view class="ha-preview">物业公告、日常巡检保洁的工作照片会第一时间出现在这里</view>
      </view>
    </view>
  </block>
</view>
