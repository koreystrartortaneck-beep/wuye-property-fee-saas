.bind-card {
  margin-top: 32rpx;
  padding: 36rpx;
}

.bind-card-title {
  font-size: 32rpx;
  font-weight: 800;
}

.bind-card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-4, #8b8199);
}

.phone-row {
  margin-top: 26rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.phone-input {
  flex: 1;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 28rpx;
}

/*
 * flex 行里的次要按钮。用 <view> 而不是 <button> ——
 * <button> 自带一套我们控制不了的默认样式，加了 width: auto 依然被撑得很大
 * （业主两次指出「这个按钮没必要那么大」，两次都没修掉）。
 * 换成 view 之后宽度就是我们说了算。
 */
.inline-btn {
  flex-shrink: 0;
  width: auto;
  height: 88rpx;
  padding: 0 40rpx;
}

/*
 * 通栏按钮必须靠父容器的 flex 撑开，不能靠 width: 100%。
 * <button open-type> 是唯一不能换成 view 的情况（授权能力只有 button 有），
 * 而它在真机上不听 width: 100%，只有半屏宽、居中飘着。
 * flex: 1 是确定的：父容器没有多余空间，按钮自身的默认 margin 也就无处可去。
 */
.btn-row {
  margin-top: 20rpx;
  display: flex;
}

.btn-fill {
  flex: 1;
  min-width: 0;
  height: 84rpx;
}

/* 输入即搜的搜索框：整行独占，旁边不再挂按钮 */
.search-input {
  margin-top: 26rpx;
  width: 100%;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 28rpx;
  box-sizing: border-box;
}

/*
 * 列表的状态说明：搜索中 / 无结果 / 被截断。
 * 尤其是被截断 —— 不说的话，业主翻不到自己家只会以为物业没登记。
 */
.list-hint {
  margin-top: 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: var(--text-4, #8b8199);
}

.option-list {
  margin-top: 24rpx;
}

.option-item {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 按下反馈：没有它，用户点了没动静时会以为没点上 */
.option-item-hover {
  background: rgba(37, 28, 56, 0.04);
}

.option-text {
  flex: 1;
  min-width: 0;
}

/* 取值与「我的」页的 .arrow 一致：不再往这套界面里加第 N 种箭头样式 */
.option-arrow {
  flex-shrink: 0;
  font-size: 48rpx;
  line-height: 1;
  color: var(--gold, #c9a66b);
}

.option-main {
  font-size: 30rpx;
  font-weight: 700;
}

.option-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
}

.picked-line {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--plum-2, #5a4680);
  font-weight: 700;
}

/* 小区名可能很长，省略它而不是把右边的「更换」挤出屏幕 */
.picked-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 选错小区原来没有任何出路，只能退出页面重进 */
.picked-change {
  flex-shrink: 0;
  color: var(--gold-deep, #b8862f);
  font-weight: 700;
}

/* 选中的房号：整行标出来，不再用一片圆角标签铺满屏幕 */
.option-item-active {
  background: rgba(201, 166, 107, 0.12);
  border-radius: 20rpx;
  padding-left: 20rpx;
  padding-right: 20rpx;
}

.option-item-active .option-main {
  color: var(--gold-deep, #b8862f);
  font-weight: 800;
}

/* 提交中：变灰并让人看出点不动了 */
.btn-busy {
  opacity: 0.6;
}

.form-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.form-label {
  width: 170rpx;
  font-size: 26rpx;
  color: var(--text-2, #55496b);
}

.form-input {
  flex: 1;
  height: 80rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.picker-value {
  line-height: 80rpx;
}

.apply-btn {
  margin-top: 36rpx;
  width: 100%;
}

/* 原生导航栏下收紧顶部留白 */
.page.bind-page {
  padding-top: 32rpx;
}


/*
 * picker 必须自己参与 flex 布局。
 *
 * <picker> 包着一个 flex: 1 的子元素时，那个 flex 是失效的 ——
 * 真正的 flex 子项是外层的 picker，它按内容宽收缩。
 * 结果同一列里，input 通栏、picker 缩成一颗小胶囊，看着参差不齐。
 * 三个页面（绑定房屋 / 预约 / 访客）都是这个形状，一并统一。
 */
picker {
  flex: 1;
  min-width: 0;
}

/*
 * 房号列表限高滚动。
 * 20 行铺开有两屏高，会把姓名、与房屋关系、提交按钮整个推出视野 ——
 * 业主选完房号就以为完事了，根本不知道下面还有必填项。
 * 约七行的高度：够看出「这是个可滚的列表」，又不至于淹掉表单。
 */
.option-scroll {
  max-height: 620rpx;
}

/*
 * 失败态要看得出可点。
 * 只写一句「加载失败」而不给出口，业主唯一能做的就是反复改关键词。
 */
.list-hint-error {
  color: var(--danger, #c45656);
  font-weight: 600;
}

/* 可点的提示行（如「查看全部」）：不点就看不出可点，等于没有 */
.list-hint-action {
  color: var(--gold-deep, #b8862f);
  font-weight: 600;
}
