.bind-card {
  margin-top: 32rpx;
  padding: 36rpx;
}

.bind-card-title {
  font-size: 32rpx;
  font-weight: 800;
}

.bind-card-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-4, #8b8199);
}

.phone-row {
  margin-top: 26rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.phone-input {
  flex: 1;
  height: 88rpx;
  padding: 0 30rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 28rpx;
}

.match-btn {
  /*
   * 只占内容宽。原来只写了 flex-shrink: 0 —— 而小程序 button 的基准宽度
   * 远大于内容，不收缩反而让它把输入框挤掉一半：
   * 「搜索」两个字占了整行的 45%，输入框反倒放不下小区名。
   */
  flex-shrink: 0;
  width: auto;
  height: 88rpx;
  padding: 0 44rpx;
}

.option-list {
  margin-top: 24rpx;
}

.option-item {
  padding: 24rpx 8rpx;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* 按下反馈：没有它，用户点了没动静时会以为没点上 */
.option-item-hover {
  background: rgba(37, 28, 56, 0.04);
}

.option-text {
  flex: 1;
  min-width: 0;
}

/* 取值与「我的」页的 .arrow 一致：不再往这套界面里加第 N 种箭头样式 */
.option-arrow {
  flex-shrink: 0;
  font-size: 48rpx;
  line-height: 1;
  color: var(--gold, #c9a66b);
}

.option-main {
  font-size: 30rpx;
  font-weight: 700;
}

.option-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
}

.picked-line {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--plum-2, #5a4680);
  font-weight: 700;
}

.house-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.house-option {
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 24rpx;
}

.house-option-active {
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold, #c9a66b));
  font-weight: 800;
}

.form-row {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.form-label {
  width: 170rpx;
  font-size: 26rpx;
  color: var(--text-2, #55496b);
}

.form-input {
  flex: 1;
  height: 80rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 26rpx;
  display: flex;
  align-items: center;
}

.picker-value {
  line-height: 80rpx;
}

.apply-btn {
  margin-top: 36rpx;
  width: 100%;
}

/* 原生导航栏下收紧顶部留白 */
.page.bind-page {
  padding-top: 32rpx;
}

.match-btn-full {
  width: 100%;
  height: 84rpx;
  margin-top: 8rpx;
}

/*
 * picker 必须自己参与 flex 布局。
 *
 * <picker> 包着一个 flex: 1 的子元素时，那个 flex 是失效的 ——
 * 真正的 flex 子项是外层的 picker，它按内容宽收缩。
 * 结果同一列里，input 通栏、picker 缩成一颗小胶囊，看着参差不齐。
 * 三个页面（绑定房屋 / 预约 / 访客）都是这个形状，一并统一。
 */
picker {
  flex: 1;
  min-width: 0;
}
