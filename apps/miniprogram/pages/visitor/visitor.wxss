.page.visitor-page {
  padding-top: 32rpx;
}

.v-card {
  padding: 32rpx;
}

/* 未绑定房屋时的引导说明：原先无规则，与标题同字号同颜色，读起来分不出主次 */
.v-guide-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: var(--text-3, #7c7288);
  line-height: 1.55;
}

.v-title {
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 8rpx;
}

.v-form-row {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.v-label {
  width: 150rpx;
  font-size: 26rpx;
  color: var(--text-2, #55496b);
  flex-shrink: 0;
}

.v-input {
  flex: 1;
  height: 80rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(37, 28, 56, 0.05);
  font-size: 26rpx;
}

.picker-view {
  line-height: 80rpx;
}

.v-btn {
  margin-top: 34rpx;
  width: 100%;
}

.v-section {
  margin: 36rpx 4rpx 20rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.pass-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.pass-item {
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.pass-dim {
  opacity: 0.6;
}

.pass-code {
  flex-shrink: 0;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: var(--gold-ink, #9b743a);
}

.pass-info {
  flex: 1;
  min-width: 0;
}

.pass-name {
  font-size: 28rpx;
  font-weight: 800;
}

.pass-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
}

.pass-side {
  flex-shrink: 0;
  text-align: right;
}

.pass-status {
  font-size: 22rpx;
  font-weight: 700;
}

.ps-ACTIVE { color: var(--success, #3f7d5d); }
.ps-USED { color: var(--text-6, #9a92a3); }
.ps-EXPIRED { color: var(--gold-deep, #b8862f); }
.ps-CANCELED { color: var(--danger, #c45656); }

.pass-cancel {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--danger, #c45656);
}

/*
 * picker 必须自己参与 flex 布局。
 *
 * <picker> 包着一个 flex: 1 的子元素时，那个 flex 是失效的 ——
 * 真正的 flex 子项是外层的 picker，它按内容宽收缩。
 * 结果同一列里，input 通栏、picker 缩成一颗小胶囊，看着参差不齐。
 * 三个页面（绑定房屋 / 预约 / 访客）都是这个形状，一并统一。
 */
picker {
  flex: 1;
  min-width: 0;
}
