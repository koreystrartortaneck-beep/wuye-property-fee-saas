.page.cpn-page {
  padding-top: 24rpx;
}

.cpn-tabs {
  display: flex;
  padding: 10rpx;
  margin-bottom: 22rpx;
}

.cpn-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-3, #7c7288);
}

.tab-on {
  color: var(--text, #251c38);
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold-pale, #ead0a0));
}

.cpn-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

/* 券卡：左侧金色面额区 + 中部信息 + 右侧动作 */
.ticket {
  display: flex;
  align-items: stretch;
  border-radius: 32rpx;
  overflow: hidden;
  background: rgba(253, 251, 247, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 20rpx 48rpx rgba(70, 52, 29, 0.08);
}

.ticket-dim {
  opacity: 0.55;
}

.ticket-left {
  width: 210rpx;
  flex-shrink: 0;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--white, #fff);
  background: radial-gradient(circle at 80% 0%, rgba(232, 207, 160, 0.4), transparent 40%), linear-gradient(150deg, #2b2145, var(--plum, #3b2b57));
  position: relative;
}

.ticket-left::after {
  content: "";
  position: absolute;
  right: -12rpx;
  top: 0;
  bottom: 0;
  width: 24rpx;
  background-image: radial-gradient(circle at 0 12rpx, transparent 12rpx, rgba(253, 251, 247, 0.92) 12rpx);
  background-size: 24rpx 32rpx;
  background-repeat: repeat-y;
}

.ticket-value {
  font-size: 60rpx;
  font-weight: 900;
  color: #e8cfa0;
  font-family: DIN Alternate, sans-serif;
  line-height: 1;
}

.tv-cur {
  font-size: 30rpx;
}

.ticket-sub {
  margin-top: 10rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.75);
}

.ticket-mid {
  flex: 1;
  min-width: 0;
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.ticket-name {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}

.ticket-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3, #7c7288);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}

.ticket-code {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--gold-ink, #9b743a);
  font-weight: 600;
}

/*
 * 有效期 + 剩余张数这一行不允许折行。
 *
 * 折行会让这张卡比同列表里其它卡高出一行 —— 三张卡高度不齐、右侧「领取」按钮
 * 跟着上下错位，列表看着就散了。而这行是补充信息，宁可截断也不该改变卡片高度。
 */
.ticket-valid {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-5, #a79eb5);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 剩余张数：跟在操作下方，居中对齐按钮 */
.ticket-stock {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--text-5, #a79eb5);
  text-align: center;
  white-space: nowrap;
}

.ticket-right {
  flex-shrink: 0;
  padding: 0 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ticket-btn {
  height: 60rpx;
  padding: 0 30rpx;
  font-size: 24rpx;
}

.ticket-got {
  font-size: 23rpx;
  color: var(--success, #3f7d5d);
  font-weight: 700;
}

.ticket-out {
  font-size: 23rpx;
  color: var(--text-5, #a79eb5);
}

.ticket-status {
  font-size: 24rpx;
  font-weight: 800;
}

.ts-UNUSED { color: var(--gold-ink, #9b743a); }
.ts-USED { color: var(--text-6, #9a92a3); }
.ts-EXPIRED { color: var(--gold-deep, #b8862f); }

.cpn-empty {
  padding: 60rpx 40rpx;
  text-align: center;
}

.ce-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}

.ce-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-4, #8b8199);
  line-height: 1.5;
}

/* ---------- 三态（加载中 / 失败 / 未绑房）---------- */
.cpn-state {
  margin-top: 24rpx;
  padding: 56rpx 32rpx;
  text-align: center;
}
.cs-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text, #251c38);
}
.cs-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-4, #8b8199);
  line-height: 1.6;
}
.cs-btn {
  margin-top: 28rpx;
  display: inline-flex;
  height: 72rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
}

/* ── 亮码核销 ── */
.ticket-qr-btn {
  margin-top: 10rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: var(--plum, #3b2b57);
  color: var(--white, #fff);
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
}
.qr-mask {
  position: fixed;
  inset: 0;
  background: rgba(20, 14, 34, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}
.qr-card {
  width: 560rpx;
  padding: 44rpx 36rpx 32rpx;
  border-radius: 32rpx;
  background: var(--white, #fff);
  text-align: center;
}
.qr-name {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--text, #251c38);
  margin-bottom: 22rpx;
}
.qr-img {
  width: 440rpx;
  height: 440rpx;
  display: block;
  margin: 0 auto;
}
.qr-code-text {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: var(--text-2, #55496b);
  font-variant-numeric: tabular-nums;
}
.qr-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
}
.qr-close {
  margin-top: 24rpx;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(59, 43, 87, 0.08);
  font-size: 27rpx;
  font-weight: 700;
  color: var(--text, #251c38);
}
