.page.svc-page {
  padding-top: 24rpx;
}

.svc-tabs {
  display: flex;
  padding: 10rpx;
  margin-bottom: 22rpx;
}

.svc-tab {
  flex: 1;
  height: 64rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-3, #7c7288);
}

.tab-on {
  color: var(--text, #251c38);
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold-pale, #ead0a0));
}

.svc-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.svc-item {
  display: flex;
  gap: 22rpx;
  padding: 24rpx;
}

.svc-cover {
  width: 170rpx;
  height: 170rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: rgba(37, 28, 56, 0.06);
}

.svc-cover-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 900;
  color: var(--gold, #c9a66b);
  background: linear-gradient(145deg, #fbf0db, #fffaf2);
}

.svc-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.svc-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}

/*
 * 描述固定占两行高度。
 *
 * 只写 line-clamp:2 而不定高，一行的描述与两行的描述会让卡片高度不等 ——
 * 服务菜单是拿来横向比价的，几张卡高低不齐就不像一份菜单。
 * 宁可短描述下方留一点空白，也要让这一列对齐。
 */
.svc-desc {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-3, #7c7288);
  line-height: 1.4;
  min-height: 64rpx; /* 23rpx × 1.4 × 2 行 */
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.svc-bottom {
  margin-top: auto;
  padding-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.svc-price {
  font-size: 40rpx;
  font-weight: 900;
  color: var(--gold-ink, #9b743a);
  font-family: DIN Alternate, sans-serif;
}

.svc-cur {
  font-size: 24rpx;
}

.svc-unit {
  font-size: 22rpx;
  color: var(--text-5, #a79eb5);
  font-weight: 500;
}

.svc-btn {
  height: 64rpx;
  padding: 0 34rpx;
  font-size: 25rpx;
}

/* 我的预约 */
.order-item {
  padding: 28rpx;
}

.order-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.order-name {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}

.order-status {
  font-size: 23rpx;
  font-weight: 700;
}

.s-PENDING { color: var(--gold-deep, #b8862f); }
.s-ACCEPTED { color: var(--plum-2, #5a4680); }
.s-DONE { color: var(--success, #3f7d5d); }
.s-CANCELED { color: var(--text-6, #9a92a3); }

.order-meta {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-3, #7c7288);
}

.order-remark {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: var(--text-4, #8b8199);
}

.order-cancel {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--danger, #c45656);
}

.svc-empty {
  padding: 60rpx 40rpx;
  text-align: center;
}

.se-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}

.se-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--text-4, #8b8199);
  line-height: 1.5;
}
