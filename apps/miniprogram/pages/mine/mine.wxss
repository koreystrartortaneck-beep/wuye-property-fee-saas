

.profile-card {
  margin-top: 28rpx;
  padding: 44rpx 36rpx;
  border-radius: 56rpx;
  display: flex;
  align-items: center;
  gap: 26rpx;
  color: var(--white, #fff);
  background: radial-gradient(circle at 88% 0%, rgba(201, 166, 107, 0.34), transparent 30%), linear-gradient(150deg, #2b2145 0%, var(--text, #251c38) 55%, var(--plum, #3b2b57) 100%);
  box-shadow: 0 34rpx 80rpx rgba(37, 28, 56, 0.24);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text, #251c38);
  font-size: 40rpx;
  font-weight: 900;
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold, #c9a66b));
}

.profile-name {
  font-size: 40rpx;
  font-weight: 900;
}

.profile-phone {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 25rpx;
}

/*
 * 未绑定手机号时那一行是个按钮。
 * 必须清掉小程序 button 的默认外观（白底、圆角、1px 边框、最小宽度、
 * 以及 ::after 那圈边框），否则深色档案卡上会突兀地出现一个白方块。
 * 视觉上要与 .profile-phone 一致，只是多一个 › 表示可点。
 */
.phone-bind-btn {
  margin: 10rpx 0 0;
  padding: 0;
  background: transparent;
  color: var(--gold, #c9a66b);
  font-size: 25rpx;
  line-height: 1.4;
  text-align: left;
  border: none;
  min-height: 0;
  width: auto;
  display: inline-block;
}
.phone-bind-btn::after {
  border: none;
}

.profile-phone-hint {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.55);
  font-size: 21rpx;
  line-height: 1.4;
}

.section-title {
  margin: 36rpx 4rpx 20rpx;
  font-size: 38rpx;
  font-weight: 900;
}

/* ---- 方案3：当前房屋单卡 + 弹出切换 ---- */
.current-house {
  padding: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.ch-left {
  min-width: 0;
  flex: 1;
}

.house-community {
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
}

.ch-title-row {
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.ch-name {
  font-size: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.house-tag {
  flex-shrink: 0;
  display: inline-flex;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  color: var(--gold-ink, #9b743a);
  font-size: 21rpx;
  font-weight: 800;
  background: rgba(201, 166, 107, 0.16);
}

.ch-right {
  flex-shrink: 0;
  text-align: right;
}

.ch-count {
  font-size: 21rpx;
  color: var(--text-5, #a79eb5);
}

.ch-switch {
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: var(--gold-ink, #9b743a);
}

/* 申请进度细行 */
.pending-lines {
  margin-top: 16rpx;
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pending-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-dot {
  flex-shrink: 0;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d9a94e;
}

.dot-rejected {
  background: var(--danger, #c45656);
}

/*
 * 驳回态：整行转为警示色，并给出「重新申请」入口。
 * 只把圆点变红是不够的 —— 圆点 8rpx，在一行 23rpx 的淡灰文字旁边等于没有。
 */
.pending-line-rejected .pending-text {
  color: var(--danger, #c45656);
  font-weight: 600;
}

.pending-action {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: var(--danger, #c45656);
}

.pending-body {
  flex: 1;
  min-width: 0;
}

.pending-text {
  display: block;
  font-size: 23rpx;
  color: var(--text-4, #8b8199);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 原因：允许换行。读不出信息的截断等于没有这段文字 */
.pending-why {
  display: block;
  margin-top: 4rpx;
  font-size: 21rpx;
  line-height: 1.5;
  color: var(--text-4, #8b8199);
  opacity: 0.85;
}

.menu-title {
  margin-top: 42rpx;
}

.menu-card {
  padding: 8rpx 30rpx;
}

.menu-row {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 1rpx solid rgba(37, 28, 56, 0.06);
}

.menu-row:first-child {
  border-top: 0;
}

.menu-name {
  font-size: 29rpx;
  font-weight: 900;
}

.menu-desc {
  margin-top: 8rpx;
  color: var(--text-3, #7c7288);
  font-size: 24rpx;
}

.arrow {
  color: var(--gold, #c9a66b);
  font-size: 48rpx;
  line-height: 1;
}

/* 申请进度（打磨新增） */
.pending-card {
  opacity: 0.92;
}

.tag-pending {
  color: var(--gold-deep, #b8862f);
}

.tag-rejected {
  color: var(--danger, #c45656);
}

/* ---------- 注销账号（危险操作，视觉与普通菜单区分）---------- */
.danger-row {
  border-top: none;
}
.danger-name {
  color: var(--danger, #c45656);
}

/*
 * 代码指纹。刻意做得很轻——它是给我们自己排查用的，
 * 业主看见也不会误以为是功能，但需要时一眼能找到（永远在页面最底）。
 */
.build-stamp {
  margin: 36rpx 0 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3, #7c7288);
  opacity: 0.55;
}
