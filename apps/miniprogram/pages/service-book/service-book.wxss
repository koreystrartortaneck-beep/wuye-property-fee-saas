.page.book-page {
  padding-top: 28rpx;
}

.book-hero {
  padding: 36rpx;
}

.bh-name {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}

.bh-price {
  margin-top: 14rpx;
  font-size: 48rpx;
  font-weight: 900;
  color: var(--gold-ink, #9b743a);
  font-family: DIN Alternate, sans-serif;
}

.bh-cur {
  font-size: 26rpx;
}

.bh-unit {
  font-size: 24rpx;
  color: var(--text-5, #a79eb5);
  font-weight: 500;
}

.bh-desc {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--text-3, #7c7288);
  line-height: 1.5;
}

.book-form {
  margin-top: 24rpx;
  padding: 12rpx 32rpx;
}

.bf-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 100rpx;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.06);
}

.bf-row:last-child {
  border-bottom: none;
}

.bf-row-top {
  align-items: flex-start;
  padding: 24rpx 0;
}

.bf-label {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 27rpx;
  color: var(--text-2, #55496b);
  font-weight: 600;
}

.bf-input {
  flex: 1;
  font-size: 27rpx;
}

.picker-v {
  color: var(--text, #251c38);
}

.bf-textarea {
  flex: 1;
  height: 140rpx;
  font-size: 27rpx;
}

.book-submit {
  margin-top: 40rpx;
  width: 100%;
}

.book-tip {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-5, #a79eb5);
}

/*
 * picker 必须自己参与 flex 布局。
 *
 * <picker> 包着一个 flex: 1 的子元素时，那个 flex 是失效的 ——
 * 真正的 flex 子项是外层的 picker，它按内容宽收缩。
 * 结果同一列里，input 通栏、picker 缩成一颗小胶囊，看着参差不齐。
 * 三个页面（绑定房屋 / 预约 / 访客）都是这个形状，一并统一。
 */
picker {
  flex: 1;
  min-width: 0;
}
