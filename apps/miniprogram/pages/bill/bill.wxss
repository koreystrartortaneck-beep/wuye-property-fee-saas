

/* ---------- 汇总细条 ---------- */
.summary-card {
  margin-top: 24rpx;
  padding: 24rpx 30rpx;
  border-radius: 36rpx;
  color: var(--white, #fff);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: radial-gradient(circle at 90% 0%, rgba(201, 166, 107, 0.32), transparent 30%), linear-gradient(150deg, #2b2145 0%, var(--text, #251c38) 55%, var(--plum, #3b2b57) 100%);
  box-shadow: 0 22rpx 54rpx rgba(37, 28, 56, 0.2);
}

/* 汇总卡左栏：.summary-card 是 space-between 的 flex，左栏纵向排布标签与金额 */
.summary-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.summary-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 22rpx;
  letter-spacing: 2rpx;
}

.summary-amount {
  margin-top: 6rpx;
  font-size: 46rpx;
  font-weight: 900;
}

/*
 * 汇总的占位/错误文案：与金额同位置，但**不能长得像金额** ——
 * 用小一号字 + 降透明度，避免被当成一个真实数字读走。
 * 与 pay-confirm 的 .pay-amount-loading 同一处理。
 */
.summary-amount-hint {
  font-size: 26rpx;
  font-weight: 600;
  opacity: 0.62;
  letter-spacing: 0;
}

.summary-btn {
  height: 68rpx;
  padding: 0 30rpx;
  font-size: 25rpx;
  flex-shrink: 0;
}

/* ---------- 筛选区（状态 + 科目 同卡） ---------- */
.filter-panel {
  margin-top: 20rpx;
  padding: 10rpx 12rpx;
}

.tabs-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.tab-item {
  height: 60rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-3, #7c7288);
  font-size: 25rpx;
  font-weight: 700;
}

.tab-active {
  color: var(--text, #251c38);
  background: linear-gradient(145deg, var(--note, #fff1c8), var(--gold-pale, #ead0a0));
}

.filter-divider {
  height: 1rpx;
  margin: 10rpx 8rpx;
  background: rgba(37, 28, 56, 0.06);
}

.chips-row {
  white-space: nowrap;
}

.chips-inner {
  display: inline-flex;
  gap: 10rpx;
  padding: 2rpx 6rpx 6rpx;
}

.filter-chip {
  display: inline-flex;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: var(--text-3, #7c7288);
  background: rgba(37, 28, 56, 0.04);
}

.chip-active {
  color: var(--gold-ink, #9b743a);
  font-weight: 800;
  background: rgba(201, 166, 107, 0.18);
}

/* ---------- 账期分组 ---------- */
.bill-stack {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.group-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 8rpx 12rpx 0;
  margin-top: 6rpx;
}

.group-period {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--text, #251c38);
  letter-spacing: 1rpx;
}

.group-subtotal {
  font-size: 22rpx;
  color: var(--text-4, #8b8199);
}

/* ---------- 账单卡片（两行式：标题独占一行更舒展） ---------- */
/* 账单文案块撑开剩余宽度（.bill-item 是 flex，不加则按内容收缩） */
.bill-info {
  flex: 1;
  min-width: 0;
}

.bill-item {
  padding: 28rpx 26rpx;
  display: flex;
  align-items: stretch;
  gap: 22rpx;
}

.bill-paid {
  opacity: 0.72;
}

.bill-dot {
  flex-shrink: 0;
  width: 8rpx;
  align-self: stretch;
  border-radius: 999rpx;
}

.sapphire { background: linear-gradient(180deg, #4a3870, var(--text, #251c38)); }
.emerald { background: linear-gradient(180deg, #6f9795, #315f63); }
.amber { background: linear-gradient(180deg, #ddbd76, var(--gold-ink, #9b743a)); }

.bill-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.bill-row1 {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 18rpx;
}

.bill-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  color: var(--text, #251c38);
  line-height: 1.35;
}

.bill-money {
  flex-shrink: 0;
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text, #251c38);
}

.bill-row2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.bill-meta {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.bill-period {
  color: var(--text-4, #8b8199);
  font-size: 23rpx;
  /* 日期绝不折行：断在年月中间的日期（「2026-08-」/「31」）比省略难读得多 */
  white-space: nowrap;
}

.status {
  flex-shrink: 0;
  display: inline-flex;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  color: var(--gold-ink, #9b743a);
  font-size: 21rpx;
  font-weight: 800;
  background: rgba(201, 166, 107, 0.16);
}

.status-paid {
  color: var(--plum-2, #5a4680);
  background: rgba(90, 70, 128, 0.14);
}

.status-overdue {
  color: var(--danger, #c45656);
  background: rgba(196, 86, 86, 0.12);
}

/*
 * 入账中：业主已付款、我们还没销账。
 *
 * 用「已缴」的紫色系，不用金色 —— 这一点是截图之后改的。
 * 第一版用了金色（想表达「好消息」），渲染出来发现它和「待缴」的金色徽章
 * 几乎一样：业主一眼扫过去会以为这笔还要交钱，而消除这个焦虑正是这个状态
 * 存在的全部理由。
 *
 * 现在的视觉语言是：颜色表示「哪一侧」（金＝待处理，紫＝已付），
 * 卡片明暗表示「是否还在进行中」（入账中不压暗，已缴压到 .72）。
 * 于是「入账中」和「已缴」同色而亮度不同，和「待缴」则一眼分得开。
 *
 * 放在 .status-paid 之后：settling 的行同时带 paid 与 settling 两个类，这里要赢。
 */
.status-settling {
  color: var(--plum-2, #5a4680);
  /* 比「已缴」略深一点，配合不压暗的卡片，读起来是「刚刚发生、还在走」 */
  background: rgba(90, 70, 128, 0.2);
}

.bill-selected {
  border: 2rpx solid var(--gold, #c9a66b);
  box-shadow: 0 18rpx 44rpx rgba(155, 116, 58, 0.22);
}

/* 勾选圈（catchtap，与整卡详情分离） */
.check-circle {
  flex-shrink: 0;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(155, 116, 58, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--cream-2, #fdfbf7);
  transition: all 0.15s ease;
}

.check-on {
  border-color: var(--gold, #c9a66b);
  background: linear-gradient(145deg, #e3bd7d, var(--gold-ink, #9b743a));
  box-shadow: 0 6rpx 16rpx rgba(155, 116, 58, 0.35);
}

/* 卡内缴费按钮（小巧，不喧宾夺主） */
.bill-pay-btn {
  flex-shrink: 0;
  height: 62rpx;
  padding: 0 40rpx;
  font-size: 26rpx;
  box-shadow: 0 12rpx 26rpx rgba(155, 116, 58, 0.22);
}

/* 详情箭头（整卡可点的视觉引导） */
.chevron {
  flex-shrink: 0;
  color: rgba(130, 120, 108, 0.55);
  font-size: 34rpx;
  font-weight: 300;
}

/* .list-end 已提到 app.wxss，四个分页列表共用一份 */
