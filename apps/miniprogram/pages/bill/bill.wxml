<view class="page has-navbar">
  <view style="height: {{nav.spacerPx}}px"></view>
  <view class="nav-row" style="height: {{nav.rowPx}}px">
    <view class="nav-row-title">账单中心</view>
  </view>
  <view class="nav-sub-row">{{house ? house.communityName + ' · ' + house.displayName : '清晰记录每一笔物业费用'}}</view>

  <!-- 未绑定房屋引导 -->
  <view wx:if="{{noHouse}}" class="state">
    <view class="state-icon">🏠</view>
    <view class="state-text">绑定房屋后即可查看与缴纳物业费</view>
    <button class="gold-button state-cta" bindtap="goBind">去绑定房屋</button>
  </view>

  <!--
    汇总细条（单账单单支付：仅展示待缴合计，逐张在卡片内缴费）。

    三态必须分开：加载中 / 取不到 / 有值。
    此前只有「有值」一种，而 data 初值是 unpaidCount:0 + unpaidTotal:'0.00'，
    于是首屏先画出「待缴合计 · 0 笔 ¥ 0.00」——下面列表明明列着十几笔待缴，
    两个数字自相矛盾，而更醒目的那个是错的；summary 请求失败时它还会一直停在 0。
    首页早就按这个原则做了独立加载态，账单页当时漏了。
  -->
  <view wx:if="{{!noHouse}}" class="summary-card">
    <view class="summary-left">
      <view class="summary-label">待缴合计{{summaryLoaded ? ' · ' + unpaidCount + ' 笔' : ''}}</view>
      <view wx:if="{{summaryLoaded}}" class="summary-amount amount">¥ {{unpaidTotal}}</view>
      <view wx:elif="{{summaryError}}" class="summary-amount summary-amount-hint" bindtap="loadSummary">取不到，点击重试</view>
      <view wx:else class="summary-amount summary-amount-hint">计算中…</view>
    </view>
  </view>

  <!-- 筛选区：状态 + 科目 同卡分两行 -->
  <view class="filter-panel card" wx:if="{{!noHouse}}">
    <view class="tabs-row">
      <block wx:for="{{tabs}}" wx:key="*this">
        <view class="tab-item {{activeTab === index ? 'tab-active' : ''}}" data-index="{{index}}" bindtap="setTab">{{item}}</view>
      </block>
    </view>
    <block wx:if="{{filters.length > 2}}">
      <view class="filter-divider"></view>
      <scroll-view class="chips-row" scroll-x>
        <view class="chips-inner">
          <view
            wx:for="{{filters}}"
            wx:key="ruleId"
            class="filter-chip {{activeRuleId === item.ruleId ? 'chip-active' : ''}}"
            data-id="{{item.ruleId}}"
            bindtap="setFilter"
          >{{item.name}}</view>
        </view>
      </scroll-view>
    </block>
  </view>

  <!-- 按账期分组 -->
  <view class="bill-stack" wx:if="{{!noHouse}}">
    <block wx:for="{{groups}}" wx:key="period" wx:for-item="group">
      <view class="group-head">
        <view class="group-period">{{group.periodText}}</view>
        <view class="group-subtotal" wx:if="{{!group.partial}}">{{group.count}} 笔 · ¥{{group.subtotal}}</view>
        <view class="group-subtotal" wx:else>已加载 {{group.count}} 笔</view>
      </view>
      <block wx:for="{{group.items}}" wx:key="id">
        <!--
          bill-paid 会把整张卡片压到 opacity .72（表示「这条已经办完了」）。
          入账中的账单 paid 为 true（为了收起缴费按钮），但它不该被压暗 ——
          那是业主此刻最盯着看的一行，压暗后像是已失效的条目。
          「不能再付」和「已经办完」是两件事，这里把它们分开。
        -->
        <view class="bill-item card {{item.paid && !item.settling ? 'bill-paid' : ''}}"
              data-id="{{item.id}}" bindtap="goDetailById">
          <view class="bill-dot {{item.theme}}"></view>

          <view class="bill-body">
            <view class="bill-row1">
              <view class="bill-name">{{item.title}}</view>
              <view class="bill-money amount">¥{{item.amount}}</view>
            </view>
            <view class="bill-row2">
              <view class="bill-meta">
                <text class="bill-period">{{item.subline}}</text>
                <view class="status {{item.paid ? 'status-paid' : ''}} {{item.overdue ? 'status-overdue' : ''}} {{item.settling ? 'status-settling' : ''}}">{{item.status}}</view>
              </view>
              <!-- 用 view 而不是 button：button 自带的默认宽度会把左边的「到期 xx-xx · 待缴」挤到折行 -->
              <view wx:if="{{!item.paid}}" class="gold-button bill-pay-btn" data-id="{{item.id}}" catchtap="payBill">缴费</view>
              <view wx:else class="chevron">›</view>
            </view>
          </view>
        </view>
      </block>
    </block>

    <!-- 加载失败要与「真的没有账单」区分开，否则业主以为本月无需缴费 -->
    <view wx:if="{{error && bills.length === 0}}" class="state">
      <view class="state-icon">⚠️</view>
      <view class="state-text">没能加载账单，请检查网络</view>
      <button class="state-retry" bindtap="retry">点击重试</button>
    </view>

    <view wx:elif="{{bills.length === 0}}" class="bill-item card">
      <view class="bill-info">
        <view class="bill-name">暂无账单</view>
        <view class="bill-period">{{house ? '当前分类下没有账单' : '请先在首页绑定房屋'}}</view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="list-loading">正在加载…</view>
    <view wx:if="{{bills.length > 0 && bills.length >= total}}" class="list-end">已显示全部 {{total}} 笔</view>
  </view>
</view>
