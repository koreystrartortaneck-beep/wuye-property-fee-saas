.confirm-page {
  padding-bottom: 56rpx;
}

.pay-card {
  margin-top: 36rpx;
  padding: 54rpx 38rpx;
  border-radius: 58rpx;
  color: #fff;
  text-align: center;
  background: radial-gradient(circle at 86% 0%, rgba(201, 166, 107, 0.78), transparent 30%), linear-gradient(145deg, #251c38, #3b2b57 66%, #5a4680);
  box-shadow: 0 34rpx 80rpx rgba(37, 28, 56, 0.24);
}

.pay-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  letter-spacing: 5rpx;
}

.pay-amount {
  margin-top: 18rpx;
  font-size: 74rpx;
  font-weight: 900;
}

.pay-house {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
  background: rgba(255, 255, 255, 0.12);
}

.detail-card,
.method-card {
  margin-top: 26rpx;
  padding: 32rpx;
}

.detail-title {
  margin-bottom: 16rpx;
  font-size: 31rpx;
  font-weight: 900;
}

.detail-row {
  min-height: 74rpx;
  padding: 16rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  color: #5f574d;
  font-size: 26rpx;
  border-top: 1rpx solid rgba(37, 28, 56, 0.06);
}

.detail-name {
  flex: 1;
  min-width: 0;
  line-height: 1.4;
}

.detail-amount {
  flex-shrink: 0;
  font-weight: 800;
  color: #251c38;
}

.method-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.method-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.wechat-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
  background: linear-gradient(145deg, #6f9795, #315f63);
}

.method-title {
  font-size: 29rpx;
  font-weight: 900;
}

.method-desc {
  margin-top: 8rpx;
  color: #7c7288;
  font-size: 24rpx;
}

.check-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  background: #9b743a;
}

.submit-btn {
  margin-top: 36rpx;
  width: 100%;
}

/* 原生导航栏下收紧顶部留白 */
.page.confirm-page {
  padding-top: 32rpx;
}

/*
 * 不可缴费原因提示（收款暂停 / 上一笔在进行中 / 已缴清）。
 * 这三块原先只有 class="paused-tip card"，而 app.wxss 的 .card 只管圆角描边阴影、
 * 不含内边距，且 .paused-title/.paused-desc 完全没有规则——文字贴着卡片边缘、
 * 标题和说明一样大。这是业主「为什么交不了钱」时唯一能看到的解释，必须清楚。
 */
.paused-tip {
  margin-top: 26rpx;
  padding: 30rpx 32rpx;
}

.paused-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #251c38;
  line-height: 1.35;
}

.paused-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #7c7288;
  line-height: 1.55;
}

/* 优惠券名称块撑开剩余宽度，右侧勾选标记才会稳定贴右 */
.coupon-info {
  flex: 1;
  min-width: 0;
}

/* ---------- 优惠券抵扣 ---------- */
.coupon-card {
  margin-top: 20rpx;
  padding: 24rpx;
}
.coupon-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8rpx;
}
.coupon-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #251c38;
}
.coupon-sub {
  font-size: 24rpx;
  color: #8b8199;
}
.coupon-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(37, 28, 56, 0.06);
}
.coupon-row.on .coupon-name {
  color: #9b743a;
}
.coupon-name {
  font-size: 27rpx;
  font-weight: 600;
  color: #251c38;
}
.coupon-meta {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #8b8199;
}
.coupon-check {
  width: 40rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #9b743a;
}

.pay-sum {
  margin-top: 20rpx;
  padding: 24rpx;
}
.ps-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #5f574d;
  padding: 6rpx 0;
}
.ps-row.discount {
  color: #9b743a;
}
.ps-row.total {
  margin-top: 8rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(37, 28, 56, 0.08);
  font-size: 30rpx;
  font-weight: 800;
  color: #251c38;
}
