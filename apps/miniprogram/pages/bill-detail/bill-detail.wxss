.page.detail-page {
  padding-top: 32rpx;
}

.detail-hero {
  padding: 48rpx 40rpx;
  text-align: center;
}

.detail-status {
  display: inline-block;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  background: rgba(230, 162, 60, 0.14);
  color: var(--gold-deep, #b8862f);
}

.detail-status.ok {
  background: rgba(63, 125, 93, 0.12);
  color: var(--success, #3f7d5d);
}

.detail-status.bad {
  background: rgba(196, 86, 86, 0.12);
  color: var(--danger, #c45656);
}

.detail-amount {
  margin-top: 26rpx;
  font-size: 72rpx;
  font-weight: 800;
  color: var(--text, #251c38);
}

.detail-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.detail-house {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-4, #8b8199);
}

.calc-card {
  margin-top: 28rpx;
  padding: 36rpx;
}

.calc-head {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

.calc-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(37, 28, 56, 0.06);
  font-size: 26rpx;
}

.calc-row:last-child {
  border-bottom: none;
}

.calc-label {
  color: var(--text-4, #8b8199);
}

.calc-value {
  color: var(--text, #251c38);
  font-weight: 600;
  text-align: right;
  max-width: 420rpx;
}

.text-bad {
  color: var(--danger, #c45656);
}

.pay-now {
  margin-top: 40rpx;
  width: 100%;
}

/*
 * 入账中的说明条。放在缴费按钮的位置上 —— 那是业主此刻会看的地方，
 * 而他最需要知道的正是「钱已经收到了，别再付」。
 */
.settling-tip {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(201, 166, 107, 0.14);
  color: var(--gold-ink, #9b743a);
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}
